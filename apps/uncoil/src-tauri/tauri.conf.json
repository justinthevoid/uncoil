{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "uncoil",
  "mainBinaryName": "uncoil-app",
  "version": "0.1.0",
  "identifier": "io.github.justinthevoid.uncoil",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "uncoil",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "uncoil contributors",
    "copyright": "Copyright (C) 2026 uncoil contributors. GPL-3.0-or-later.",
    "license": "GPL-3.0-or-later",
    "homepage": "https://github.com/justinthevoid/uncoil",
    "category": "Utility",
    "shortDescription": "Lighting and settings for Razer peripherals, without Synapse",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../LICENSE": "LICENSE.txt",
      "../../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
