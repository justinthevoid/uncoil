---
// One Razer feature report, all 90 bytes, coded by field (colour as code; the legend names each one).
// Source: docs/PROTOCOL.md, "Transport".
type Field = { from: number; to: number; name: string; code: string; note: string };
const fields: Field[] = [
	{ from: 0, to: 0, name: 'Status', code: 'red', note: '00 new · 01 busy · 02 ok · 03 fail · 04 no answer · 05 unsupported' },
	{ from: 1, to: 1, name: 'Transaction id', code: 'yellow', note: '1F keyboard and mouse · 3F mat' },
	{ from: 2, to: 5, name: 'Header', code: 'grey', note: 'remaining packets, protocol type, data size' },
	{ from: 6, to: 7, name: 'Command', code: 'blue', note: 'class, id (high bit set = get)' },
	{ from: 8, to: 87, name: 'Arguments', code: 'open', note: 'up to 80 bytes' },
	{ from: 88, to: 88, name: 'CRC', code: 'white', note: 'XOR of bytes 2–87' },
	{ from: 89, to: 89, name: 'Reserved', code: 'dim', note: '' },
];
const codeAt = (i: number) => fields.find((f) => i >= f.from && i <= f.to)!.code;
const cells = Array.from({ length: 90 }, (_, i) => codeAt(i));
const range = (f: Field) => (f.from === f.to ? `${f.from}` : `${f.from}–${f.to}`);
---

<figure class="report">
	<div class="grid" role="img" aria-label="A 90-byte feature report: status, transaction id, header, command class and id, 80 argument bytes, CRC, reserved.">
		{cells.map((c, i) => <span class={`cell ${c}`} data-i={i % 30 === 0 ? i : undefined} />)}
	</div>
	<figcaption>
		<dl class="legend">
			{
				fields.map((f) => (
					<div class="row">
						<dt>
							<span class={`key ${f.code}`} aria-hidden="true" />
							<span class="caps-sm">{f.name}</span>
						</dt>
						<dd>
							<span class="off">{range(f)}</span>
							{f.note && <span class="note">{f.note}</span>}
						</dd>
					</div>
				))
			}
		</dl>
	</figcaption>
</figure>

<style>
	.report {
		margin: 0;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(30, 1fr);
		gap: 3px;
		padding-left: 0;
	}
	.cell {
		aspect-ratio: 1 / 1.6;
		position: relative;
	}
	.cell[data-i]::before {
		content: attr(data-i);
		position: absolute;
		bottom: calc(100% + 4px);
		left: 0;
		font-size: 10px;
		letter-spacing: 0.1em;
		color: var(--color-ink-3);
		font-variant-numeric: tabular-nums;
	}
	.grid {
		margin-top: 18px;
		row-gap: 22px;
	}
	.red {
		background: var(--color-fac-red);
	}
	.yellow {
		background: var(--color-fac-yellow);
	}
	.grey {
		background: var(--color-fac-grey);
	}
	.blue {
		background: var(--color-fac-blue);
	}
	.white {
		background: var(--color-fac-white);
	}
	.open {
		box-shadow: inset 0 0 0 1px var(--color-seam-2);
	}
	.dim {
		box-shadow: inset 0 0 0 1px var(--color-seam);
	}
	.legend {
		margin: 22px 0 0;
		display: grid;
		gap: 0;
	}
	.row {
		display: grid;
		grid-template-columns: minmax(0, 13rem) minmax(0, 1fr);
		gap: 16px;
		padding: 8px 0;
		border-top: 1px solid var(--color-seam);
		font-size: 13px;
	}
	dt {
		display: flex;
		align-items: center;
		gap: 10px;
		color: var(--color-ink);
	}
	.key {
		width: 10px;
		height: 10px;
		flex: none;
	}
	dd {
		margin: 0;
		color: var(--color-ink-3);
		display: flex;
		flex-wrap: wrap;
		gap: 4px 14px;
	}
	.off {
		color: var(--color-ink-2);
		font-variant-numeric: tabular-nums;
		min-width: 3.5em;
	}
	@media (max-width: 560px) {
		.row {
			grid-template-columns: 1fr;
			gap: 4px;
		}
	}
</style>
