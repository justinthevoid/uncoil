---
// Page title with its catalog number set inline before it (never as a kicker above the heading).
const { title, fac } = Astro.locals.starlightRoute.entry.data;
---

<h1 id="_top">
	{fac && <span class="cat">{fac}</span>}
	<span>{title}</span>
</h1>

<style>
	h1 {
		margin-top: 1rem;
		font-size: var(--sl-text-h1);
		color: var(--sl-color-white);
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		column-gap: 1rem;
		row-gap: 0.25rem;
	}
	.cat {
		font-size: 11px;
		font-weight: 500;
		font-stretch: 115%;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--color-fac-red);
		white-space: nowrap;
		line-height: 1;
		padding: 0.45em 0.6em 0.4em;
		border: 1px solid var(--color-seam-2);
		transform: translateY(-0.35em);
	}
</style>
