---
// The docs live in the landing page's world, which is always dark: data-theme is pinned so Starlight and
// Expressive Code pick their dark styles. There is no picker (see ThemeSelect.astro); Starlight's global scripts
// still call updatePickers, so it stays as a no-op.
---

<script is:inline>
	document.documentElement.dataset.theme = 'dark';
	window.StarlightThemeProvider = { updatePickers() {} };
</script>
