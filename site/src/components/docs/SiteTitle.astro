---
// The landing page's wordmark (brass spiral, Fraunces name), linking back to it. On hover the spiral winds
// itself again, the one flourish the docs allow themselves.
const { siteTitleHref } = Astro.locals.starlightRoute;
const markPath = 'M12 12a2 2 0 1 1 2-2 4 4 0 1 1-4-4 6 6 0 1 1-6 6 8 8 0 1 1 8 8';
---

<a href={siteTitleHref} class="brand site-title">
	<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d={markPath} pathLength="1"></path></svg>
	<span class="word" translate="no">uncoil</span>
	<span class="cat">docs</span>
</a>

<style>
	.site-title {
		white-space: nowrap;
		min-width: 0;
	}
	.cat {
		margin-inline-start: 4px;
		padding-inline-start: 12px;
		border-inline-start: 1px solid var(--hair);
		font-family: var(--mono);
		font-size: 13px;
		color: var(--ink-3);
	}
	path {
		stroke-dasharray: 1;
		stroke-dashoffset: 0;
	}
	@media (prefers-reduced-motion: no-preference) {
		.site-title:hover path {
			animation: wind 900ms var(--ease-out);
		}
	}
	@keyframes wind {
		from {
			stroke-dashoffset: 1;
		}
	}
	@media (max-width: 30rem) {
		.cat {
			display: none;
		}
	}
</style>
