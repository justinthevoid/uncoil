---
// Wordmark + mark, linking back to the landing page, with the docs' own catalog code.
import Mark from '../Mark.astro';
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title">
	<Mark size={22} />
	<span class="word" translate="no">uncoil</span>
	<span class="cat" aria-hidden="true">FAC 200 · docs</span>
</a>

<style>
	.site-title {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		color: var(--color-ink);
		text-decoration: none;
		white-space: nowrap;
		min-width: 0;
	}
	.word {
		font-size: 17px;
		font-weight: 500;
		font-stretch: 125%;
		letter-spacing: 0.16em;
	}
	.cat {
		font-size: 10px;
		font-weight: 500;
		font-stretch: 112%;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--color-ink-3);
		padding-inline-start: 0.7rem;
		border-inline-start: 1px solid var(--color-seam-2);
	}
	@media (max-width: 30rem) {
		.cat {
			display: none;
		}
	}
</style>
