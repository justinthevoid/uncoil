---
// Wordmark + mark, linking back to the landing page.
import Mark from '../Mark.astro';
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title">
	<Mark size={20} />
	<span class="word" translate="no">uncoil</span>
	<span class="cat">Docs</span>
</a>

<style>
	.site-title {
		display: flex;
		align-items: center;
		gap: 8px;
		color: var(--color-ink);
		text-decoration: none;
		white-space: nowrap;
		min-width: 0;
	}
	.word {
		font-family: var(--font-display);
		font-size: 17px;
		font-weight: 650;
		letter-spacing: -0.01em;
	}
	.cat {
		margin-inline-start: 4px;
		padding-inline-start: 12px;
		border-inline-start: 1px solid var(--color-seam-2);
		font-size: 15px;
		font-weight: 500;
		color: var(--color-ink-3);
	}
	@media (max-width: 30rem) {
		.cat {
			display: none;
		}
	}
</style>
