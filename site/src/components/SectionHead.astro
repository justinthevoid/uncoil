---
interface Props {
	id: string;
	title: string;
}
const { id, title } = Astro.props;
---

<h2 {id}>{title}</h2>

<style>
	h2 {
		margin-bottom: 40px;
		font-size: clamp(1.75rem, 1.2rem + 2vw, 3rem);
		font-weight: 450;
		font-stretch: 118%;
		letter-spacing: -0.02em;
		line-height: 1.05;
		color: var(--color-ink);
	}
	@media (max-width: 560px) {
		h2 {
			margin-bottom: 28px;
		}
	}
</style>
