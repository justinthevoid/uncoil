---
// The uncoil mark: a hairline spiral unwinding into a straight line, ending on the red "live" block.
import d from '../lib/mark-path.txt?raw';
interface Props {
	size?: number;
	class?: string;
}
const { size = 22, class: cls } = Astro.props;
---

<svg class={cls} width={size} height={size} viewBox="1.5 1.5 29 29" aria-hidden="true" focusable="false">
	<path d={d.trim()} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="square"></path>
	<rect x="26" y="22.7" width="3" height="3" fill="#e2372c"></rect>
</svg>
