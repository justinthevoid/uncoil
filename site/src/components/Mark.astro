---
// The uncoil mark: the same open spiral the desktop app shows next to its name, in the current ink colour.
interface Props {
	size?: number;
	class?: string;
}
const { size = 20, class: cls } = Astro.props;
---

<svg class={cls} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
	<path d="M12 12a2 2 0 1 1 2-2 4 4 0 1 1-4-4 6 6 0 1 1-6 6 8 8 0 1 1 8 8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
</svg>
