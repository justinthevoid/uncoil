---
// The signature, as in the app's desk preview: the maintainer's desk drawn to scale (keyboard as flat keycaps,
// the mouse from above, the mat with its edge ring) and lit with uncoil's default wave. Each LED's colour comes
// from the desktop app's own port of the engine maths (apps/uncoil/src/lib/effect.ts), sampled at that LED's
// measured position in desk.json.
//
// The still frame (t = 6 s) is rendered at build time, so the page shows the real answer with no JavaScript.
// The script then animates it: only while it is on screen and the tab is visible, never under reduced motion
// unless the visitor presses Play, and the Pause button stops it at any time.
import { frame, hex } from '$uncoil/effect';
import { devices, ledCount, deskBounds, deskBox, capBox, CASE_PAD } from '../lib/desk';
import { EFFECT, STILL_T } from '../lib/wave';

const at = frame(EFFECT, STILL_T, 1, 1);
const c = (x: number, y: number) => hex(at(x, y));
const r = (n: number) => +n.toFixed(3);

const mat = devices.find((d) => d.kind === 'mousemat');
const kb = devices.find((d) => d.kind === 'keyboard');
const mice = devices.filter((d) => d.kind === 'mouse');
const wave = EFFECT.kind === 'wave' ? EFFECT : null;
---

<figure class="hero-desk" data-desk-hero>
	<div class="stage">
		<div
			class="desk"
			style={`aspect-ratio:${r(deskBounds.w)} / ${r(deskBounds.h)}`}
			role="img"
			aria-label={`The maintainer's desk drawn to scale: a BlackWidow V4 Pro 75% keyboard, a Basilisk V3 Pro mouse and a Goliathus Chroma Extended mat, lit with uncoil's default rainbow wave. ${ledCount} LEDs, each coloured at its real position.`}
		>
			{
				mat && (
					<div
						class="mat"
						style={`${deskBox(mat)};--c:${c(mat.shapes[0]?.x ?? 0, mat.shapes[0]?.y ?? 0)}`}
						data-x={r(mat.shapes[0]?.x ?? 0)}
						data-y={r(mat.shapes[0]?.y ?? 0)}
					/>
				)
			}
			{
				kb && (
					<div class="board" style={deskBox({ x: kb.x - CASE_PAD, y: kb.y - CASE_PAD, w: kb.w + CASE_PAD * 2, h: kb.h + CASE_PAD * 2 })}>
						{kb.shapes
							.filter((s) => !s.is_key)
							.map((s) => (
								<span class="led" style={`${capBox(kb, s.x, s.y, 0.22, 0.22)};--c:${c(s.x, s.y)}`} data-x={r(s.x)} data-y={r(s.y)} />
							))}
						{kb.shapes
							.filter((s) => s.is_key)
							.map((s) => (
								<span class="key" style={`${capBox(kb, s.x, s.y, s.w - 0.1, s.h - 0.1)};--c:${c(s.x, s.y)}`} data-x={r(s.x)} data-y={r(s.y)} />
							))}
					</div>
				)
			}
			{
				mice.map((m) => (
					<div class="mouse" style={deskBox(m)}>
						{m.shapes.map((s) => (
							<span
								class="mled"
								style={`left:${r(((s.x - m.x) / m.w) * 100)}%;top:${r(((s.y - m.y) / m.h) * 100)}%;--c:${c(s.x, s.y)}`}
								data-x={r(s.x)}
								data-y={r(s.y)}
							/>
						))}
					</div>
				))
			}
		</div>
	</div>
	<figcaption class="bar">
		<dl class="fx">
			<div><dt>Effect</dt><dd>Wave</dd></div>
			{
				wave && (
					<>
						<div><dt>Direction</dt><dd class="num">{wave.angle_deg}°</dd></div>
						<div><dt>Speed</dt><dd class="num">{wave.period_s} s per cycle</dd></div>
						<div><dt>Band width</dt><dd class="num">{wave.wavelength} keys</dd></div>
					</>
				)
			}
			<div><dt>LEDs</dt><dd class="num">{ledCount} on {devices.length} devices</dd></div>
		</dl>
		<button type="button" class="btn-quiet btn-sm toggle" data-toggle hidden aria-pressed="false">
			<svg class="i-pause" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M5 3.5v9M11 3.5v9" /></svg>
			<svg class="i-play" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M5 3.2v9.6L12.5 8z" /></svg>
			<span class="t">Pause</span>
		</button>
	</figcaption>
</figure>

<script>
	import { frame, hex } from '$uncoil/effect';
	import { EFFECT, STILL_T } from '../lib/wave';

	for (const fig of document.querySelectorAll<HTMLElement>('[data-desk-hero]')) {
		const els = [...fig.querySelectorAll<HTMLElement>('[data-x]')];
		const xs = els.map((e) => Number(e.dataset.x));
		const ys = els.map((e) => Number(e.dataset.y));
		const toggle = fig.querySelector<HTMLButtonElement>('[data-toggle]');
		const label = toggle?.querySelector('.t');
		const reduce = matchMedia('(prefers-reduced-motion: reduce)');

		let t = STILL_T;
		// Paused by the visitor (or, under reduced motion, until they ask for it).
		let held = reduce.matches;
		let visible = false;
		let raf = 0;
		let last = 0;

		const paint = () => {
			const at = frame(EFFECT, t, 1, 1);
			for (let i = 0; i < els.length; i++) els[i].style.setProperty('--c', hex(at(xs[i], ys[i])));
		};
		const loop = (now: number) => {
			raf = 0;
			if (held || !visible || document.hidden) return;
			raf = requestAnimationFrame(loop);
			if (last && now - last < 1000 / 30) return;
			t += last ? Math.min(0.1, (now - last) / 1000) : 0;
			last = now;
			paint();
		};
		const run = () => {
			if (!raf && !held && visible && !document.hidden) {
				last = 0;
				raf = requestAnimationFrame(loop);
			}
		};
		const sync = () => {
			if (!toggle || !label) return;
			toggle.setAttribute('aria-pressed', String(held));
			toggle.classList.toggle('held', held);
			label.textContent = held ? 'Play' : 'Pause';
		};

		if (toggle) {
			toggle.hidden = false;
			sync();
			toggle.addEventListener('click', () => {
				held = !held;
				sync();
				run();
			});
		}
		reduce.addEventListener('change', () => {
			if (reduce.matches) {
				held = true;
				t = STILL_T;
				paint();
			}
			sync();
			run();
		});
		new IntersectionObserver(([e]) => {
			visible = e.isIntersecting;
			run();
		}).observe(fig);
		document.addEventListener('visibilitychange', run);
	}
</script>

<style>
	.hero-desk {
		margin: 0;
		background: var(--color-raised);
		border: var(--hair);
		border-radius: var(--radius-lg);
		overflow: hidden;
	}
	.stage {
		padding: clamp(12px, 2.4vw, 28px);
	}
	.desk {
		position: relative;
		width: 100%;
		container-type: inline-size;
	}
	.mat,
	.board,
	.mouse {
		position: absolute;
	}
	/* The mat: a case-coloured field whose edge ring is its one LED. */
	.mat {
		border-radius: 1.6% / 4%;
		background: var(--case);
		box-shadow: inset 0 0 0 max(2px, 0.32cqw) color-mix(in srgb, var(--c) 70%, var(--case));
	}
	/* The keyboard: flat keycaps in its case, as in the app. */
	.board {
		border-radius: 0.9cqw;
		background: var(--case);
		box-shadow: inset 0 0 0 1px var(--color-seam);
	}
	.key {
		position: absolute;
		border-radius: 0.5cqw;
		background: var(--c, var(--cap));
		box-shadow:
			inset 0 -0.2cqw 0 rgb(0 0 0 / 0.16),
			0 0 0 1px var(--cap-edge);
	}
	.led {
		position: absolute;
		border-radius: 50%;
		background: var(--c, var(--color-seam-2));
	}
	.mouse {
		border-radius: 48% 48% 44% 44% / 30% 30% 22% 22%;
		background: var(--cap);
		box-shadow:
			inset 0 0 0 1px var(--cap-edge),
			inset 0 -4px 0 var(--cap-edge);
	}
	.mled {
		position: absolute;
		width: 9%;
		aspect-ratio: 1;
		translate: -50% -50%;
		border-radius: 50%;
		background: var(--c);
	}

	.bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 12px 24px;
		padding: 14px clamp(14px, 3vw, 36px);
		border-top: var(--hair);
		background: var(--color-surface);
	}
	.fx {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 28px;
		margin: 0;
	}
	.fx dt {
		font-size: 12px;
		font-weight: 500;
		color: var(--color-ink-3);
	}
	.fx dd {
		margin: 0;
		font-size: 14px;
		font-weight: 600;
		color: var(--color-ink);
	}
	.toggle svg {
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.toggle .i-play {
		display: none;
		fill: currentColor;
	}
	.toggle.held .i-play {
		display: block;
	}
	.toggle.held .i-pause {
		display: none;
	}
	@media (max-width: 560px) {
		.fx {
			display: grid;
			grid-template-columns: 1fr 1fr;
			width: 100%;
		}
	}
</style>
