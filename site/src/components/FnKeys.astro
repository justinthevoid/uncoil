---
// The swatch book at work: the BlackWidow's Fn layer drawn the way the app's Keys screen draws it. Keys that do
// something different with Fn held carry a gel tab, and the list under the board names each gel. Geometry is the
// keyboard's real layout (desk.json); the actions are the keyboard's onboard Fn map (docs/PROTOCOL.md, "Onboard
// key mappings"), with Fn+P the one key uncoil wrote itself.
import { devices, capBox, legendFor } from '../lib/desk';

type Gel = 'yours' | 'media' | 'light' | 'system';
const GEL_NAME: Record<Gel, string> = {
	yours: 'Your change',
	media: 'Media & macros',
	light: 'Lighting',
	system: 'System',
};

const fn: { key: string; sub: string; action: string; gel: Gel }[] = [
	{ key: 'Escape', sub: 'Eco', action: 'Low power mode', gel: 'system' },
	{ key: 'F9', sub: 'Macro', action: 'Macro record', gel: 'media' },
	{ key: 'F10', sub: 'Game', action: 'Game mode', gel: 'media' },
	{ key: 'F11', sub: 'Lit −', action: 'Backlight down', gel: 'light' },
	{ key: 'F12', sub: 'Lit +', action: 'Backlight up', gel: 'light' },
	{ key: 'Delete', sub: 'Sleep', action: 'System sleep', gel: 'system' },
	{ key: 'P', sub: 'PrtSc', action: 'Print screen', gel: 'yours' },
];
const byKey = new Map(fn.map((f) => [f.key, f]));
const fixed = new Set(['Left Windows', 'Right Fn']);

const kb = devices.find((d) => d.kind === 'keyboard');
const W = kb ? kb.w + 0.7 : 1;
const H = kb ? kb.h + 0.7 : 1;
---

{
	kb && (
		<figure class="fnkeys">
			<div class="board-wrap">
				<div class="board" style={`aspect-ratio:${+W.toFixed(3)} / ${+H.toFixed(3)}`} aria-hidden="true">
					{kb.shapes
						.filter((s) => !s.is_key)
						.map((s) => (
							<span class="led" style={capBox(kb, s.x, s.y, 0.22, 0.22)} />
						))}
					{kb.shapes
						.filter((s) => s.is_key)
						.map((s) => {
							const f = byKey.get(s.name);
							return (
								<span class:list={['key', { fixed: fixed.has(s.name), sel: s.name === 'P' }]} style={capBox(kb, s.x, s.y, s.w - 0.1, s.h - 0.1)}>
									{f && <span class={`tab gel-${f.gel}`} />}
									<span class="legend">{legendFor(s.name)}</span>
									{f && <span class="sub">{f.sub}</span>}
								</span>
							);
						})}
				</div>
			</div>
			<figcaption>
				<p class="list-head">
					<span class="title">What Fn changes</span>
					<span class="label">{fn.length} keys on the BlackWidow V4 Pro 75%</span>
				</p>
				<ul class="list">
					{fn.map((f) => (
						<li>
							<span class="cap">{legendFor(f.key)}</span>
							<span class="act">{f.action}</span>
							<span class="gelname">
								<span class={`gel gel-${f.gel}`} aria-hidden="true" />
								{GEL_NAME[f.gel]}
							</span>
						</li>
					))}
				</ul>
			</figcaption>
		</figure>
	)
}

<style>
	.fnkeys {
		margin: 0;
	}
	.board-wrap {
		padding: clamp(10px, 2.4vw, 22px);
		background: var(--color-raised);
		border: var(--hair);
		border-radius: var(--radius-lg);
	}
	.board {
		position: relative;
		width: 100%;
		container-type: inline-size;
		border-radius: 1.4cqw;
		background: var(--case);
		box-shadow: inset 0 0 0 1px var(--color-seam);
	}
	.key {
		position: absolute;
		display: grid;
		align-content: center;
		justify-items: center;
		gap: 0.3cqw;
		padding: 0 0.4cqw;
		border-radius: 0.75cqw;
		background: var(--cap);
		box-shadow:
			inset 0 -0.3cqw 0 var(--cap-edge),
			0 0 0 1px var(--cap-edge);
		color: var(--color-ink);
		overflow: hidden;
	}
	.key.sel {
		box-shadow:
			inset 0 0 0 2px var(--color-select),
			inset 0 -0.3cqw 0 var(--cap-edge);
	}
	.key.fixed {
		color: var(--color-ink-3);
	}
	.tab {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: max(3px, 0.45cqw);
	}
	.legend {
		font-size: clamp(9px, 1.55cqw, 14px);
		font-weight: 600;
		line-height: 1;
		white-space: nowrap;
	}
	.sub {
		max-width: 100%;
		font-size: clamp(8px, 1.1cqw, 11px);
		font-weight: 500;
		line-height: 1.1;
		color: var(--color-ink-3);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.led {
		position: absolute;
		border-radius: 50%;
		background: var(--color-seam-2);
	}
	/* Narrow boards: the gel tab marks the key, and the list below names it (as in the app). */
	@container (max-width: 560px) {
		.sub {
			display: none;
		}
	}
	@container (max-width: 440px) {
		.legend {
			display: none;
		}
	}

	figcaption {
		margin-top: 18px;
	}
	.list-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 4px 10px;
		margin-bottom: 10px;
	}
	.title {
		font-family: var(--font-display);
		font-size: 16px;
		font-weight: 600;
		color: var(--color-ink);
	}
	.list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 6px;
	}
	.list li {
		display: grid;
		grid-template-columns: 3.25rem minmax(0, 1fr) auto;
		align-items: center;
		gap: 12px;
		min-height: 40px;
		padding: 4px 12px 4px 6px;
		background: var(--color-surface);
		border: var(--hair);
		border-radius: var(--radius);
		font-size: 14px;
	}
	.cap {
		display: grid;
		place-items: center;
		height: 28px;
		border-radius: var(--radius-sm);
		background: var(--cap);
		box-shadow:
			inset 0 -2px 0 var(--cap-edge),
			0 0 0 1px var(--cap-edge);
		font-size: 12px;
		font-weight: 600;
	}
	.act {
		color: var(--color-ink);
	}
	.gelname {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		font-size: 13px;
		color: var(--color-ink-2);
		white-space: nowrap;
	}
	@media (min-width: 640px) {
		.list {
			grid-template-columns: 1fr 1fr;
		}
	}
	@media (min-width: 1000px) {
		.list {
			grid-template-columns: 1fr;
		}
	}
	@media (min-width: 1240px) {
		.list {
			grid-template-columns: 1fr 1fr;
		}
	}
</style>
