---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base title="Not found · uncoil" description="There is no page at this address.">
	<section class="nf wrap">
		<p class="label">Error 404</p>
		<h1>Nothing at this address.</h1>
		<p class="prose-ink">The page may have moved when the docs were reorganised.</p>
		<ul>
			<li><a class="btn" href={url()}>uncoil home</a></li>
			<li><a class="btn-quiet" href={url('docs/')}>Documentation</a></li>
			<li><a class="btn-quiet" href={url('docs/getting-started/')}>Getting started</a></li>
		</ul>
	</section>
</Base>

<style>
	.nf {
		padding-top: clamp(64px, 12vw, 128px);
		padding-bottom: clamp(72px, 12vw, 144px);
		min-height: 60svh;
	}
	h1 {
		margin-top: 8px;
		font-size: clamp(1.9rem, 1.3rem + 2vw, 2.75rem);
		letter-spacing: -0.02em;
		line-height: 1.1;
	}
	.prose-ink {
		margin-top: 12px;
	}
	ul {
		list-style: none;
		padding: 0;
		margin-top: 28px;
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}
</style>
