---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base title="Not found · uncoil" description="There is no page at this address.">
	<section class="nf">
		<p class="code display" aria-hidden="true">404</p>
		<h1>No entry under this catalog number.</h1>
		<p class="prose-ink">The page may have moved when the docs were reorganised.</p>
		<ul>
			<li><a class="caps caps-link" href={url()}>uncoil home</a></li>
			<li><a class="caps caps-link" href={url('docs/')}>Documentation</a></li>
			<li><a class="caps caps-link" href={url('docs/getting-started/')}>Getting started</a></li>
		</ul>
	</section>
</Base>

<style>
	.nf {
		padding: 96px var(--gutter) 120px;
		min-height: 60svh;
	}
	.code {
		font-size: clamp(4rem, 2rem + 10vw, 10rem);
		color: var(--color-ink);
	}
	h1 {
		margin-top: 32px;
		font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.25rem);
		font-weight: 400;
		font-stretch: 118%;
		line-height: 1.1;
	}
	.prose-ink {
		margin-top: 12px;
	}
	ul {
		list-style: none;
		padding: 0;
		margin-top: 32px;
		display: flex;
		flex-wrap: wrap;
		gap: 16px 32px;
	}
</style>
