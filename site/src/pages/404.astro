---
// Not found, in the landing page's world: the desk's 113 lights wound back into the coil, coloured by the
// engine's own wave, with one light missing: the page that isn't here. Plain SVG built at build time, so it
// needs no JavaScript; the lights come on along the coil once, and not at all under reduced motion.
import '../styles/world.css';
import { frameWith, hex, leds, WAVE } from '../lib/desk';
import { url, REPO } from '../lib/url';

const title = 'Not found · uncoil';
const markPath = 'M12 12a2 2 0 1 1 2-2 4 4 0 1 1-4-4 6 6 0 1 1-6 6 8 8 0 1 1 8 8';

// An Archimedean coil, 113 points spaced evenly along it (r = a·θ; arc length ≈ a·θ²/2 once wound).
const N = leds.length;
const TURNS = 3.1;
const A = 46 / (TURNS * 2 * Math.PI);
const thetaMax = TURNS * 2 * Math.PI;
const theta0 = 1.4;
const missing = Math.round(N * 0.62);
// Colour each light with the shipped wave, sampled along the wave's own direction across the desk, so the coil
// carries the same bands the desk shows.
const sample = frameWith(WAVE, 6, 1, 1);
const dir = ((WAVE.kind === 'wave' ? WAVE.angle_deg : 35) * Math.PI) / 180;
const points = Array.from({ length: N }, (_, i) => {
	const s = i / (N - 1);
	const th = Math.sqrt(theta0 ** 2 + s * (thetaMax ** 2 - theta0 ** 2));
	const r = A * th;
	const u = s * 26;
	return {
		x: +(50 + r * Math.cos(th - Math.PI / 2)).toFixed(2),
		y: +(50 + r * Math.sin(th - Math.PI / 2)).toFixed(2),
		c: hex(sample('', '', -2 + u * Math.cos(dir), -1.5 + u * Math.sin(dir))),
		gone: i === missing,
	};
});
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<meta name="color-scheme" content="dark" />
		<meta name="theme-color" content="#0e0d0c" />
		<title>{title}</title>
		<meta name="description" content="There is no page at this address." />
		<link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
	</head>
	<body>
		<header class="mast">
			<a class="brand" href={url()}>
				<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d={markPath}></path></svg>
				<span translate="no">uncoil</span>
			</a>
			<nav aria-label="Site">
				<a href={url('docs/')}>Docs</a>
				<a href={url('docs/protocol/')}>Protocol</a>
				<a href={REPO}>GitHub</a>
			</nav>
		</header>

		<main class="nf">
			<figure class="coil" aria-hidden="true">
				<svg viewBox="0 0 100 100">
					{
						points.map((p, i) =>
							p.gone ? (
								<circle class="gap" cx={p.x} cy={p.y} r="1.5" />
							) : (
								<circle class="led" cx={p.x} cy={p.y} r="1.05" fill={p.c} style={`--i:${i}`} />
							),
						)
					}
				</svg>
			</figure>
			<div class="words">
				<p class="tag">404 · one light short</p>
				<h1>Nothing at this address.</h1>
				<p class="lede">
					The coil is all here, except the page you asked for. It may have moved when the docs were reorganised.
				</p>
				<div class="ctas">
					<a class="btn" href={url()}>uncoil home</a>
					<a class="btn-q" href={url('docs/')}>Documentation</a>
					<a class="btn-q" href={url('docs/getting-started/')}>Getting started</a>
				</div>
			</div>
		</main>

		<footer class="foot">
			uncoil is an independent open-source project, not affiliated with Razer Inc. GPL-3.0-or-later.
		</footer>
	</body>
</html>

<style is:global>
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}
	html,
	body {
		background: var(--bg);
	}
	body {
		margin: 0;
		min-height: 100svh;
		display: grid;
		grid-template-rows: auto 1fr auto;
		color: var(--ink);
		font-family: var(--serif);
		font-size: 1.0625rem;
		line-height: 1.6;
		font-optical-sizing: auto;
		-webkit-font-smoothing: antialiased;
	}
	a {
		color: var(--ink);
		text-decoration-color: rgb(201 164 106 / 0.6);
		text-underline-offset: 0.2em;
	}
	a:hover {
		color: var(--brass-hi);
	}
	:focus-visible {
		outline: 2px solid var(--brass-hi);
		outline-offset: 3px;
		border-radius: 3px;
	}
</style>

<style>
	.mast {
		display: flex;
		align-items: center;
		gap: 18px;
		height: 56px;
		padding: 0 var(--gut);
		border-bottom: 1px solid var(--hair);
		font-family: var(--mono);
		font-size: 13px;
	}
	.mast nav {
		display: flex;
		gap: 16px;
		margin-left: auto;
	}
	.mast nav a {
		text-decoration: none;
		color: var(--ink-2);
	}
	.mast nav a:hover {
		color: var(--ink);
	}

	.nf {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
		align-items: center;
		gap: clamp(24px, 5vw, 72px);
		width: min(1120px, 100%);
		margin: 0 auto;
		padding: clamp(32px, 7vw, 96px) var(--gut);
	}
	.coil {
		position: relative;
		margin: 0;
		width: min(100%, 440px);
		justify-self: center;
	}
	/* the brass lamp, low behind the coil */
	.coil::before {
		content: '';
		position: absolute;
		inset: -10%;
		border-radius: 50%;
		background: radial-gradient(closest-side, rgb(201 164 106 / 0.12), transparent);
		pointer-events: none;
	}
	.coil svg {
		position: relative;
		display: block;
		width: 100%;
		height: auto;
		overflow: visible;
	}
	.gap {
		fill: none;
		stroke: var(--ink-3);
		stroke-width: 0.35;
		stroke-dasharray: 0.9 0.6;
	}
	.tag {
		margin: 0 0 14px;
		font-family: var(--mono);
		font-size: 13px;
		color: var(--brass);
	}
	h1 {
		margin: 0;
		font-size: clamp(2.2rem, 1.4rem + 3vw, 3.6rem);
		font-weight: 350;
		line-height: 1.05;
		letter-spacing: -0.02em;
		text-wrap: balance;
	}
	.lede {
		margin: 18px 0 0;
		max-width: 34ch;
		color: var(--ink-2);
	}
	.ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 10px 14px;
		margin-top: 28px;
	}
	.foot {
		padding: 20px var(--gut) 28px;
		border-top: 1px solid var(--hair);
		font-family: var(--mono);
		font-size: 12px;
		color: var(--ink-3);
	}

	/* The lights come on along the coil once; the gap breathes. Nothing moves under reduced motion. */
	@media (prefers-reduced-motion: no-preference) {
		.led {
			animation: on 900ms var(--ease-out) backwards;
			animation-delay: calc(var(--i) * 9ms);
		}
		.gap {
			animation: breathe 3.2s ease-in-out 1.4s infinite;
		}
	}
	@keyframes on {
		from {
			opacity: 0;
		}
	}
	@keyframes breathe {
		50% {
			stroke: var(--brass-hi);
		}
	}

	@media (max-width: 760px) {
		.nf {
			grid-template-columns: 1fr;
		}
		.coil {
			width: min(70%, 300px);
		}
	}
</style>
