		height: 100vh;
		z-index: 0;
		pointer-events: none;
	}
	.grain {
		position: fixed;
		inset: 0;
		z-index: 6;
		overflow: hidden;
		pointer-events: none;
		opacity: 0.045;
	}
	.grain::before {
		content: '';
		position: absolute;
		inset: -60px;
		background-image: var(--noise, none);
		background-repeat: repeat;
		animation: grain 0.9s steps(9) infinite;
	}
	@keyframes grain {
		0% { transform: translate(0, 0); }
		12% { transform: translate(-31px, 17px); }
		24% { transform: translate(23px, -40px); }
		36% { transform: translate(-47px, -9px); }
		48% { transform: translate(11px, 38px); }
		60% { transform: translate(41px, 4px); }
		72% { transform: translate(-19px, -27px); }
		84% { transform: translate(33px, 29px); }
		100% { transform: translate(-8px, -45px); }
	}

	/* ── Masthead ─────────────────────────────────────────────────────────── */
	.mast {
		position: fixed;
		inset: 0 0 auto;
		z-index: 10;
		display: flex;
		align-items: center;
		gap: 18px;
		height: 56px;
		padding: 0 var(--gut);
