---
// The landing page: "Uncoiling", one scroll-driven film.
//
// THE WORLD
// 1. It is dark. The only light comes from the desk's 113 LEDs and one brass lamp.
// 2. Nothing is cut. One set of 113 points morphs from scene to scene; the coil never breaks.
// 3. Every lit colour is the engine's own maths at that LED's real, measured position.
// 4. A number is measured on the maintainer's PC, and says so, or it is not on the page.
// 5. Words sit in the dark beside the light, never pasted over it.
//
// The film: one fixed canvas behind sticky scenes (src/film/film.ts). Scroll moves the
// points; the clock colours them. Everything the film shows is also here as text, and as still pictures when
// there is no JavaScript.
import '../styles/world.css';
import { Picture } from 'astro:assets';
import shotDark from '../assets/app-lighting-dark.png';
import { leds, MEASURED, WAVE } from '../lib/desk';
import { devices as table, experimentalDevices } from '../lib/devices';
import { url, REPO, RELEASES, blob } from '../lib/url';
import { deskSvg, fnSvg, shedSvg, FN_KEYS, GEL, FIELDS, report, hex2 } from '../film/still';

const wave = WAVE.kind === 'wave' ? WAVE : null;
const kinds = ['keyboard', 'mouse', 'mousemat'];
const ledsOf = (kind: string) => leds.filter((l) => l.kind === kind).length;
const sentence = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

const cellLight = (i: number) => {
	const { b, field } = report[i];
	switch (field) {
		case 'status':
			return 0.9;
		case 'txn':
			return 0.65;
		case 'command':
			return 0.85;
		case 'crc':
			return 0.95;
		case 'reserved':
			return 0;
		default:
			return b ? 0.78 : field === 'header' ? 0.14 : 0.06;
	}
};
const hl = new Set([0, 6, 7, 88]);
const REPORT = `${REPO}/issues/new?template=device_report.yml`;
const KIND_LABEL: Record<string, string> = { keyboard: 'Keyboards', mouse: 'Mice', mousemat: 'Mats', headset: 'Headsets', other: 'Docks and stations' };
const expGroups: { label: string; items: typeof experimentalDevices }[] = [];
for (const d of experimentalDevices) {
	const label = KIND_LABEL[d.kind] ?? sentence(d.kind);
	let g = expGroups.find((x) => x.label === label);
	if (!g) expGroups.push((g = { label, items: [] }));
	g.items.push(d);
}

const faq = [
	{
		q: 'Is uncoil made by Razer?',
		a: `No. It is an independent open-source project, not affiliated with or endorsed by Razer Inc. It speaks the same USB HID reports Razer's software uses, which <a href="https://github.com/openrazer/openrazer">OpenRazer</a> and <a href="https://gitlab.com/CalcProgrammer1/OpenRGB">OpenRGB</a> documented long before uncoil existed.`,
	},
	{
		q: 'What does it cost, and what is the licence?',
		a: `Nothing. uncoil is <a href="${REPO}/blob/main/LICENSE">GPL-3.0-or-later</a>. Protocol facts and some device data derive from OpenRazer and OpenRGB (both GPL-2.0-or-later).`,
	},
	{
		q: 'What still needs Synapse?',
		a: 'Anything uncoil does not do yet: macros, what each command-dial mode does, custom images on the BlackWidow’s dial screen, switching onboard profiles, firmware updates, and devices that are on neither the tested nor the experimental list; experimental devices may need it until someone confirms them. Key and button remapping works from the app and the command line, though only one remap (Fn+P to Print Screen) has been checked on a real keyboard so far. DPI, polling rate, the sleep timer and the scroll wheel are there too; DPI, the poll rate, scroll mode and Smart Reel are confirmed on the Basilisk V3 Pro, and for the rest uncoil reads each value before it changes anything. Settings already stored in a device’s own memory stay there after Synapse is gone.',
	},
	{
		q: 'Can Synapse stay installed?',
		a: `Not running at the same time: both would write to the same LEDs. Quit Synapse completely, or uninstall it; the <a href="${url('docs/getting-started/')}">getting started guide</a> covers doing that without leaving the keyboard stuck in driver mode.`,
	},
	{
		q: 'Does it work alongside OpenRGB, SignalRGB or iCUE?',
		a: `Leave the Razer devices to uncoil; any other app driving them will fight it for the LEDs, and uncoil shows a notice when it sees Synapse, OpenRGB or SignalRGB running. For the rest of the PC, uncoil can use OpenRGB (off by default; install with <code>-OpenRgb</code>): either once at sign-in, to put the motherboard, GPU and RAM on their own hardware modes, or live, so they follow the desk effect. It skips the RAM while iCUE is running because they share the SMBus. See <a href="${url('docs/configuration/#openrgb')}">configuration</a>.`,
	},
	{
		q: 'Does it need administrator rights?',
		a: 'Once, to copy the executable into Program Files. The daemon runs as you, unelevated, and talks to Razer devices as plain user-mode HID. Only the optional OpenRGB part runs elevated, from its own logon task, because RAM lighting sits on the SMBus. There is no service and no kernel driver.',
	},
	{
		q: 'Does it phone home?',
		a: 'No. There is no account, no telemetry and no updater. uncoild reads one config file, writes a status file, a small log and a record of writes to device memory, all under your user profile, and answers the app and the command line over a local pipe only your account can open. Its one network connection is in the optional live OpenRGB mode, to OpenRGB on 127.0.0.1, on this PC.',
	},
	{
		q: 'Mac or Linux?',
		a: 'Windows 10 and 11 only. On Linux, <a href="https://openrazer.github.io/">OpenRazer</a> already does this job well.',
	},
];
const markPath = 'M12 12a2 2 0 1 1 2-2 4 4 0 1 1-4-4 6 6 0 1 1-6 6 8 8 0 1 1 8 8';
const title = 'uncoil: a 1.4 MB replacement for Razer Synapse';
const description =
	'uncoil runs the lighting on Razer keyboards, mice and mats from one small background process on Windows. Open source, GPL-3.0. Not affiliated with Razer.';
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" class="no-js">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="dark" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
		<meta name="theme-color" content="#0e0d0c" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content="summary" />
		<script is:inline>
			document.documentElement.classList.replace('no-js', 'js');
		</script>
	</head>
	<body>
		<a class="skip" href="#install">Skip the film: go to install</a>
		<div class="lamp" aria-hidden="true"></div>
		<canvas id="film" aria-hidden="true"></canvas>
		<div class="grain" aria-hidden="true"></div>

		<header class="mast">
			<a class="brand" href="#top">
				<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d={markPath}></path></svg>
				<span>uncoil</span>
			</a>
			<nav aria-label="Site">
				<a href={url('docs/')}>Docs</a>
				<a class="wide-only" href={url('docs/protocol/')}>Protocol</a>
				<a href={REPO}>GitHub</a>
			</nav>
			<button type="button" class="light" data-light-toggle aria-pressed="false" hidden>
				<span class="lamp" aria-hidden="true"></span><span class="t">Pause the light</span>
			</button>
		</header>

		<main>
			<!-- ── 1. The coil unwinds into the desk ─────────────────────────────────────────── -->
			<section id="top" class="scene hero" data-scene="hero" aria-labelledby="hero-title">
				<div class="pin">
					<div class="hero-title">
						<p class="kicker">Lighting for Razer keyboards, mice and mats, on Windows</p>
						<h1 id="hero-title">A 1.4&nbsp;MB replacement for Razer&nbsp;Synapse.</h1>
					</div>
					<div class="hero-side">
						<p class="lede">
							uncoil runs the lighting on your Razer keyboard, mouse and mat from one small background process.
							Uninstall Synapse; keep the desk.
						</p>
						<p class="sub">Open source, GPL-3.0. No services, no account, no telemetry, no kernel drivers. Pre-release, from v0.1.0. <a href="#devices">{table.length} devices tested, {experimentalDevices.length} more experimental</a>.</p>
						<div class="ctas">
							<a class="btn" href={url('docs/getting-started/')}>Read the setup guide</a>
							<a class="btn-q" href={REPO}>Source on GitHub</a>
						</div>
					</div>
					<div class="slot" data-slot>
						<div
							class="still"
							role="img"
							aria-label="The maintainer’s desk drawn to scale: a BlackWidow V4 Pro 75% keyboard, a Basilisk V3 Pro mouse and a Goliathus Chroma Extended mat, lit with uncoil’s default rainbow wave. 113 LEDs, each coloured at its real position."
							set:html={deskSvg()}
						/>
					</div>
					<div class="hero-cap">
						<dl class="readout">
							<div><dt>Effect</dt><dd>Wave</dd></div>
							{wave && <div><dt>Direction</dt><dd>{wave.angle_deg}°</dd></div>}
							{wave && <div><dt>Speed</dt><dd>{wave.period_s} s per cycle</dd></div>}
							{wave && <div class="wide-only"><dt>Band width</dt><dd>{wave.wavelength} keys</dd></div>}
							<div><dt>LEDs</dt><dd>{leds.length} on {table.length} devices</dd></div>
							<div><dt>Support</dt><dd>{table.length} tested · {experimentalDevices.length} experimental</dd></div>
						</dl>
						<p class="fine">
							uncoil’s default effect on the maintainer’s desk, computed in your browser by the same wave maths uncoild runs.
						</p>
					</div>
					<p class="cue" aria-hidden="true"><span>Scroll</span></p>
				</div>
				<div class="spacer" aria-hidden="true"></div>
			</section>

			<!-- ── 2. Shed: seventeen coils fall away; one line stays ───────────────────────── -->
			<section id="weight" class="scene" data-scene="shed" aria-labelledby="shed-title">
				<div class="pin">
					<div class="slot" data-slot>
						<div class="still" aria-hidden="true" set:html={shedSvg()} />
						<p class="tag tag-top" aria-hidden="true">Synapse 4 · 17 processes</p>
						<p class="tag tag-bottom" aria-hidden="true">uncoild · 1 process</p>
					</div>
				</div>
				<div class="beats">
					<div class="beat" style="--bh:130svh">
						<div class="plate">
							<p class="label">Measured on the maintainer’s PC</p>
							<h2 id="shed-title">Seventeen processes, shed.</h2>
							<p>uncoild against Razer Synapse 4, on one Ryzen desktop with the three devices drawn above.</p>
							<dl class="ledger">
								<div>
									<dt>Processes</dt>
									<dd class="now"><b data-type>{MEASURED.processes}</b></dd>
									<dd class="was"><span class="sr-only">Synapse 4: </span><span aria-hidden="true">Synapse 4 · </span><span data-type data-type-delay="200">{MEASURED.synapseProcesses}</span></dd>
								</div>
								<div>
									<dt>Memory</dt>
									<dd class="now"><b data-type data-type-delay="150">{MEASURED.ram}</b></dd>
									<dd class="was"><span class="sr-only">Synapse 4: </span><span aria-hidden="true">Synapse 4 · </span><span data-type data-type-delay="350">~1.4 GB at start, then several GB over days</span></dd>
								</div>
								<div>
									<dt>CPU, wave running</dt>
									<dd class="now"><b data-type data-type-delay="300">&lt;1%</b> <span class="unit">of one core</span></dd>
									<dd class="was"><span class="sr-only">Synapse 4: </span><span aria-hidden="true">Synapse 4 · </span><span data-type data-type-delay="500">~7% of one core</span></dd>
								</div>
								<div>
									<dt>Install size</dt>
									<dd class="now"><b data-type data-type-delay="450">{MEASURED.binary}</b></dd>
									<dd class="was"><span class="sr-only">Synapse 4: </span><span aria-hidden="true">Synapse 4 · </span><span data-type data-type-delay="650">~500 MB</span></dd>
								</div>
							</dl>
							<p class="fine">
								One executable: the build of 2026-10-07 is {MEASURED.binaryBytes.toLocaleString('en-US')} bytes. uncoild sends each
								frame and sleeps until the next. Memory and CPU were measured on an earlier build. One machine; yours will differ.
							</p>
						</div>
					</div>
				</div>
			</section>

			<!-- ── 3. One field: the desk becomes the screen, then the desk again ─────────────── -->
			<section id="desk" class="scene" data-scene="field" aria-labelledby="field-title">
				<div class="pin"><div class="slot" data-slot></div></div>
				<div class="beats">
					<div class="beat" style="--bh:80svh">
						<div class="plate">
							<h2 id="field-title">One effect across the whole desk.</h2>
							<p>
								Every LED has a physical position in key units (1u = 19.05&nbsp;mm), so an angled rainbow wave runs from the
								keyboard and its underglow onto the mouse and the mat as one continuous field, not three effects that happen to
								be in sync. The rainbow uses FastLED’s hue map, tuned for LEDs, so no band looks wider or brighter than the rest.
							</p>
							<p class="aside">Behind this text: the same function, sampled across your screen. Then each device, drawn from above to scale.</p>
						</div>
					</div>
					<div class="beat" style="--bh:80svh">
						<div class="plate">
							<h3>A different effect per device</h3>
							<p>
								Pick a device, or paint lights across several, and give them their own effect while the rest of the desk keeps its
								own, or stack effects as layers in Studio. Lighting follows the display: it fades when Windows turns the screen off,
								dims with it, and comes back on wake; unplugged devices are picked up again within seconds.
							</p>
							<p class="aside">Here: the desk keeps the wave, the keyboard runs fire and the mouse runs starlight. Four layers, the engine’s own maths.</p>
							<details class="more">
								<summary>The app, when you want it</summary>
								<p>
									A small desktop app sets effects and Studio layers, remaps keys and buttons, sets the dial, the screen, DPI,
									polling rate, sleep timer and scroll wheel, and shows whether each device is live. Open it, change something,
									close it; the daemon does not need it running. Changes land in <code>%APPDATA%\uncoil\config.json</code>,
									which uncoild hot-reloads. There is also a command line, <code>uncoil</code>, and, off by default, motherboard,
									GPU and RAM lighting through OpenRGB.
								</p>
								<figure class="shot">
									<Picture
										src={shotDark}
										formats={['avif']}
										fallbackFormat="webp"
										widths={[560, 900]}
										sizes="(min-width: 900px) 34rem, 100vw"
										alt="The uncoil desktop app’s Lighting screen: the desk drawn to scale and lit with the wave, cards for every effect from Wave to Off plus Studio, and the wave’s direction, speed, band width, reverse, brightness and saturation controls."
									/>
									<figcaption>The Lighting screen, on the app’s built-in demo data: the device rows and engine figures shown are synthetic.</figcaption>
								</figure>
							</details>
						</div>
					</div>
				</div>
			</section>

			<!-- ── 4. The keyboard keeps its own brain ───────────────────────────────────────── -->
			<section id="brain" class="scene" data-scene="brain" aria-labelledby="brain-title">
				<div class="pin">
					<div class="slot" data-slot>
						<div class="still" aria-hidden="true" set:html={fnSvg()} />
					</div>
				</div>
				<div class="beats">
					<div class="beat" style="--bh:80svh">
						<div class="plate">
							<h2 id="brain-title">The keyboard keeps its own brain.</h2>
							<p>
								Devices stay in firmware (normal) mode, so Fn keys, media keys and the dial keep working when uncoil is not
								running. Hold Fn, and every key that does something different carries a gel naming the kind of change.
							</p>
							<ul class="fnlist" aria-label="What Fn changes on the BlackWidow V4 Pro 75%">
								{
									FN_KEYS.map((f) => (
										<li>
											<span class="cap">{f.key === 'Escape' ? 'Esc' : f.key === 'Delete' ? 'Del' : f.key}</span>
											<span>{f.action}</span>
											<span class="gname"><span class="gel" style={`--g:${GEL[f.gel].hex}`} aria-hidden="true" />{GEL[f.gel].name}</span>
										</li>
									))
								}
							</ul>
							<p class="fine">
								The four gels, each with one job:{' '}
								{(Object.keys(GEL) as (keyof typeof GEL)[]).map((g, i) => (
									<>
										{i > 0 && '; '}
										<b>{GEL[g].name}</b>, {GEL[g].job}
									</>
								))}.
							</p>
						</div>
					</div>
					<div class="beat" style="--bh:80svh">
						<div class="plate">
							<h3>Fn+P, written to the keyboard. Then stop the daemon.</h3>
							<pre class="bytes"><code><span data-type>02/0D  [1, 26, 1, 2, 2, 0, 0x46]</span>
<span class="ann" data-type data-type-delay="900">profile 1 · key P · Fn layer · key code · Print Screen</span></code></pre>
							<p>
								One report into the keyboard’s onboard key map: Fn+P was an empty entry, which is why the Print Screen on its
								keycap did nothing without Synapse. Now the firmware handles it: no driver mode, no daemon, works on any PC.
								Verified on hardware; it still reads back <code>2 [0, 0x46]</code>.
							</p>
							<p class="aside">
								Only this one remap has been checked on a real keyboard so far. The app and the command line write the rest:{' '}
								<code>uncoil keymap set keyboard P key PRINT_SCREEN --layer fn --write</code>
							</p>
						</div>
					</div>
				</div>
			</section>

			<!-- ── 5. Written down: the points become bytes, then the device list ───────────── -->
			<section id="protocol" class="scene" data-scene="written" aria-labelledby="written-title">
				<div class="pin">
					<div class="slot" data-slot>
						<figure class="strip">
							<figcaption class="fig-title">The Fn+P write as one feature report, all 90 bytes</figcaption>
							<div class="grid" data-strip role="img" aria-label="A 90-byte feature report: status 00, transaction id 1F, header with data size 50, command 02 0D, the arguments 01 1A 01 02 02 00 46 followed by zeros, then the CRC and a reserved byte.">
								{report.map((c, i) => (
									<span class:list={['cell', `f-${c.field}`, { on: cellLight(i) >= 0.5, hl: hl.has(i) }]} style={`--i:${i};--l:${cellLight(i)}`}>{hex2(c.b)}</span>
								))}
							</div>
						</figure>
					</div>
				</div>
				<div class="beats">
					<div class="beat" style="--bh:88svh">
						<div class="plate">
							<h2 id="written-title">Written down.</h2>
							<p>
								<strong>Prior art first:</strong> the report format is public thanks to OpenRazer and OpenRGB.{' '}
								<strong>Then Razer’s own logs:</strong> Synapse 4 logs every command it sends, and mining {MEASURED.logsMined}{' '}
								produced a catalogue of {MEASURED.commands} commands and {MEASURED.inputEvents} distinct input events, with no USB
								sniffer. <strong>Then the hardware:</strong> small probes, and a human checking what the LEDs did. Synapse leaves
								devices in driver mode; the BlackWidow freezes if the custom-frame command is re-sent every frame, and silently
								stops applying frames unless every reply is read.
							</p>
							<details class="more">
								<summary>Reading the strip</summary>
								<dl class="fields">
									{
										FIELDS.map((f) => (
											<div>
												<dt><span class={`sw f-${f.field}`} aria-hidden="true" />{f.name}</dt>
												<dd><span class="off">{f.from === f.to ? f.from : `${f.from}–${f.to}`}</span> {f.note}</dd>
											</div>
										))
									}
								</dl>
							</details>
							<p class="links">
								<a class="btn-q" href={url('docs/protocol/')}>Read the protocol write-up</a>
								<a href={blob('docs/PROTOCOL.md')}>PROTOCOL.md on GitHub</a>
							</p>
						</div>
					</div>
					<div class="beat wide" style="--bh:auto">
						<div class="plate" id="devices">
							<h3 id="devices-title">Devices: {table.length} tested, {experimentalDevices.length} experimental</h3>
							<p class="tally" role="img" aria-label={`${table.length} tested devices and ${experimentalDevices.length} experimental ones`}>
								{table.map(() => <span class="t-on" />)}
								{experimentalDevices.map(() => <span class="t-x" />)}
							</p>
							<p class="cap-label" id="tested-label"><span class="badge">Tested</span> confirmed on the maintainer’s hardware</p>
							<div class="table-wrap">
								<table class="devices" aria-labelledby="tested-label">
									<thead>
										<tr>
											<th scope="col">Device</th>
											<th scope="col">Lighting</th>
											<th scope="col">LEDs</th>
											<th scope="col">USB</th>
											<th scope="col">Data file</th>
										</tr>
									</thead>
									<tbody>
										{
											table.map((d) => (
												<tr>
													<th scope="row">
														<span class="dev">{d.name}</span>
														<span class="kind">{sentence(d.kind)}</span>
													</th>
													<td>{d.lighting}</td>
													<td class="ledcell">
														<span class="num">{d.leds}</span>
														{kinds.includes(d.kind) && ledsOf(d.kind) === d.leds && (
															<span class="bar" data-bar={d.kind} style={`--cols:${Math.ceil(d.leds / 3)}`} aria-hidden="true" />
														)}
													</td>
													<td>
														{d.usb.map((u) => (
															<span class="usb"><span class="num">{u.pid}</span> {u.connection}</span>
														))}
													</td>
													<td><a href={blob(d.file)}>{d.file.replace('devices/', '')}</a></td>
												</tr>
											))
										}
									</tbody>
								</table>
							</div>
							<div class="exp">
								<p class="cap-label"><span class="badge badge-x">Experimental</span> from OpenRazer and OpenRGB data, not yet confirmed on hardware</p>
								<div class="exp-groups">
									{
										expGroups.map((g) => (
											<div class="exp-group">
												<h4>{g.label} <span class="count">{g.items.length}</span></h4>
												<ul>
													{g.items.map((d) => (
														<li>
															{d.name.replace(/^Razer /, '')}
															{d.effectsOnly && <span class="note"> (firmware effects only)</span>}
														</li>
													))}
												</ul>
											</div>
										))
									}
								</div>
								<p>
									Before uncoil changes anything stored on an experimental device (key and button mappings, DPI stages, polling
									rate, sleep timer, scroll wheel settings), it reads a few settings first to make sure the device answers the way
									it expects; nothing is written until that check passes. Own one? <a href={REPORT}>Tell us whether it works</a>.
								</p>
							</div>
							<p class="fine">
								All generated from the same <code>devices/*.toml</code> files the daemon compiles in; the dots in the table are the
								desk’s {leds.length} LEDs, one each. A new device is mostly a data file: USB endpoints, quirks, the LED matrix and
								where each LED sits. <a href={url('docs/devices/#experimental')}>The full list</a> ·{' '}
								<a href={url('docs/devices/')}>how to add one</a>.
							</p>
						</div>
					</div>
				</div>
			</section>

			<!-- ── 6. Install: the points wind back into the mark ─────────────────────────────── -->
			<section id="install" class="install" data-scene="install" aria-labelledby="install-title">
				<div class="mark-col">
					<div class="mark-stick">
						<div class="mark-slot" data-mark-slot>
							<svg class="still" viewBox="0 0 24 24" aria-hidden="true"><path d={markPath}></path></svg>
						</div>
						<p class="mark-cap" aria-hidden="true">The same {leds.length} lights, wound back up.</p>
					</div>
				</div>
				<div class="install-body">
					<h2 id="install-title">Install</h2>
					<p class="lede-s">Three steps. The daemon has no installer; there is not much to install.</p>
					<ol class="steps">
						<li>
							<h3>Download</h3>
							<p>
								From <a href={RELEASES}>GitHub Releases</a>: <code>uncoild.exe</code>, <code>install-task.ps1</code> and, if you
								want them, the <code>uncoil.exe</code> command line and the desktop app’s installer, into one folder. Check them
								against <code>SHA256SUMS.txt</code> (<code>Get-FileHash file</code>). Or build from source:{' '}
								<code>cargo build --release -p uncoild</code> in a clone of the <a href={REPO}>repository</a>.
							</p>
						</li>
						<li>
							<h3>Retire Synapse</h3>
							<p>
								Quit Synapse from its tray icon, then uninstall it from Windows Settings. If the keyboard dial scrolls instead of
								changing volume afterwards, the device was left in driver mode: uncoil resets it on connect, and an unplug and
								replug fixes it either way.
							</p>
						</li>
						<li>
							<h3>Run it at logon</h3>
							<pre><code>powershell -ExecutionPolicy Bypass -File .\install-task.ps1</code></pre>
							<p>
								From the download folder (or <code>scripts\install-task.ps1</code> in a clone). Copies the executable to{' '}
								<code>%ProgramFiles%\uncoil</code>, registers a scheduled task named <code>uncoil</code> that starts at logon, and
								starts it now. The lighting should change within a second.
							</p>
						</li>
					</ol>
					<p class="links">
						<a class="btn" href={RELEASES}>Get the release</a>
						<a class="btn-q" href={url('docs/getting-started/')}>Getting started</a>
						<a href={url('docs/')}>All the docs</a>
					</p>
				</div>
			</section>

			<section id="faq" class="faq" aria-labelledby="faq-title">
				<h2 id="faq-title">Questions</h2>
				<div class="qs">
					{
						faq.map((f) => (
							<details>
								<summary>{f.q}</summary>
								<p set:html={f.a} />
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="foot">
			<p class="indep">
				<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d={markPath}></path></svg>
				uncoil is an independent open-source project. It is not affiliated with, endorsed by or connected to Razer Inc.;
				device names appear only to say what it works with.
			</p>
			<p>
				GPL-3.0-or-later. Every figure on this page was measured on the maintainer’s PC: one machine, and yours will differ.
			</p>
			<nav aria-label="Footer">
				<a href={url('docs/')}>Docs</a>
				<a href={url('docs/protocol/')}>Protocol</a>
				<a href={REPO}>GitHub</a>
				<a href={RELEASES}>Releases</a>
				<a class="seed" data-seed href="?seed=1">replay this visit</a>
			</nav>
		</footer>

		<script>
			import { start } from '../film/film';
			start();
		</script>
	</body>
</html>

<style is:global>
