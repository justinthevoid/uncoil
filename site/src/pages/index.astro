---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PulsePlot from '../components/PulsePlot.svelte';
import DeskMap from '../components/DeskMap.astro';
import ReportStrip from '../components/ReportStrip.astro';
import SectionHead from '../components/SectionHead.astro';
import appShot from '../assets/app-lighting.png';
import { devices, totalLeds } from '../lib/devices';
import { url, REPO, RELEASES, blob } from '../lib/url';

const sections = [
	{ id: 'top', n: '01', label: 'uncoil' },
	{ id: 'does', n: '02', label: 'What it does' },
	{ id: 'app', n: '03', label: 'The app' },
	{ id: 'devices', n: '04', label: 'Devices' },
	{ id: 'built', n: '05', label: 'How it was built' },
	{ id: 'install', n: '06', label: 'Install' },
	{ id: 'faq', n: '07', label: 'FAQ' },
];

// Measured on the maintainer's PC (README.md, PRODUCT.md). The only numbers on this site.
const ledger = [
	{ k: 'Processes', synapse: '17', uncoil: '1', unit: '' },
	{ k: 'Memory', synapse: '~1.4 GB at start, leaking', uncoil: '~3', unit: 'MB' },
	{ k: 'CPU, animating', synapse: '~7% of one core', uncoil: '<1', unit: '% of one core' },
	{ k: 'Install size', synapse: '~500 MB', uncoil: '651', unit: 'KB' },
];

const features = [
	{
		n: '201',
		title: 'One effect across the whole desk',
		body: 'Every LED has a physical position in key units (1u = 19.05 mm), so an angled rainbow wave runs from the keyboard and its side underglow onto the mouse and the mat as one continuous field, not three effects that happen to be in sync.',
	},
	{
		n: '202',
		title: 'The keyboard keeps its own brain',
		body: 'Devices stay in firmware (normal) mode, so Fn keys, media keys and the dial keep working even when uncoil is not running. Key remaps can be written into the keyboard’s own memory: on the BlackWidow, Fn+P becomes a native Print Screen that works with nothing installed at all.',
	},
	{
		n: '203',
		title: 'Follows the display',
		body: 'Lighting fades out when Windows turns the display off, dims when Windows dims it, and comes back on wake. Devices that were unplugged are picked up again within seconds.',
	},
	{
		n: '204',
		title: 'Even colour',
		body: 'Uses FastLED’s rainbow hue map, tuned for LEDs, so no band of the wave looks wider or brighter than the rest.',
	},
	{
		n: '205',
		title: 'Written down',
		body: 'The protocol, the quirks and every device are documented in the repository. A new device is a data file, not a fork.',
	},
];

const faq = [
	{
		q: 'Is uncoil made by Razer?',
		a: `No. It is an independent open-source project, not affiliated with or endorsed by Razer Inc. It speaks the same USB HID reports Razer's software uses, which <a href="https://github.com/openrazer/openrazer">OpenRazer</a> and <a href="https://gitlab.com/CalcProgrammer1/OpenRGB">OpenRGB</a> documented long before uncoil existed.`,
	},
	{
		q: 'What does it cost, and what is the licence?',
		a: `Nothing. uncoil is <a href="${REPO}/blob/main/LICENSE">GPL-3.0-or-later</a>. Protocol facts and some device data derive from OpenRazer and OpenRGB (both GPL-2.0).`,
	},
	{
		q: 'What still needs Synapse?',
		a: 'Anything uncoil does not do yet: editing the Fn layer from a UI, the BlackWidow’s dial functions and OLED images, macros and button remapping, DPI settings, firmware updates, and devices that are not on the list. Settings already stored in a device’s own memory stay there after Synapse is gone.',
	},
	{
		q: 'Can Synapse stay installed?',
		a: `Not running at the same time: both would write to the same LEDs. Quit Synapse completely, or uninstall it; the <a href="${url('docs/getting-started/')}">getting started guide</a> covers doing that without leaving the keyboard stuck in driver mode.`,
	},
	{
		q: 'Does it work alongside OpenRGB, SignalRGB or iCUE?',
		a: `Leave the Razer devices to uncoil; any other app driving them will fight it for the LEDs. For the rest of the PC, uncoil can optionally run OpenRGB once at start to put the motherboard, GPU and RAM on their own hardware rainbow, and skips the RAM while iCUE is running because they share the SMBus.`,
	},
	{
		q: 'Why does the logon task run elevated?',
		a: 'Only so the optional OpenRGB hand-off can reach RAM over SMBus. The daemon itself talks to Razer devices as plain user-mode HID. There is no service and no kernel driver.',
	},
	{
		q: 'Does it phone home?',
		a: 'No. There is no account, no telemetry and no updater. uncoild reads one config file and writes a status file and a small log, all under your user profile.',
	},
	{
		q: 'Mac or Linux?',
		a: 'Windows 10 and 11 only. On Linux, <a href="https://openrazer.github.io/">OpenRazer</a> already does this job well.',
	},
];
---

<Base
	title="uncoil: a 651 KB replacement for Razer Synapse"
	description="uncoil runs the lighting on Razer keyboards, mice and mats from one small background process on Windows. Open source, GPL-3.0. Measured: ~3 MB RAM, under 1% of one core."
>
	<nav class="rail" slot="rail" aria-label="Sections">
		<ol>
			{
				sections.map((s) => (
					<li>
						<a href={`#${s.id}`} data-rail={s.id}>
							<span class="num">{s.n}</span>
							<span class="rail-label">{s.label}</span>
						</a>
					</li>
				))
			}
		</ol>
	</nav>

	<!-- FAC 01: first viewport. Product and the lightness claim, with the measured numbers. -->
	<section id="top" class="hero" aria-labelledby="hero-title">
		<div class="hero-copy">
			<h1 id="hero-title">
				A <span class="hl">651&nbsp;KB</span> replacement for Razer Synapse.
			</h1>
			<p class="lede">
				uncoil runs the lighting on your Razer keyboard, mouse and mat from one small background process on Windows.
				Uninstall Synapse; keep the desk.
			</p>
			<p class="sublede">Open source. No services, no account, no telemetry, no kernel drivers.</p>

			<table class="ledger">
				<caption class="sr-only">Resource use, Razer Synapse 4 against uncoild, measured on the maintainer's PC</caption>
				<thead>
					<tr>
						<th scope="col" class="caps-sm">Measured</th>
						<th scope="col" class="caps-sm">Synapse 4</th>
						<th scope="col" class="caps-sm">uncoild</th>
					</tr>
				</thead>
				<tbody>
					{
						ledger.map((r) => (
							<tr>
								<th scope="row">{r.k}</th>
								<td class="syn">{r.synapse}</td>
								<td class="unc">
									<span class="display val">{r.uncoil}</span>
									{r.unit && <span class="unit">{r.unit}</span>}
								</td>
							</tr>
						))
					}
				</tbody>
			</table>
			<p class="fine">
				Measured on the maintainer’s PC (a Ryzen desktop with a BlackWidow V4 Pro 75%, Basilisk V3 Pro and Goliathus
				Chroma Extended), where Synapse’s memory grew to several GB over a few days. One machine; yours will differ.
			</p>

			<div class="ctas">
				<a class="btn-primary" href={RELEASES}>
					<span class="caps">Download for Windows</span>
					<span class="block" aria-hidden="true"></span>
				</a>
				<a class="caps caps-link" href={url('docs/getting-started/')}>Read the setup guide</a>
			</div>
		</div>

		<div class="hero-plot">
			<div class="plot-frame">
				<PulsePlot client:load />
			</div>
			<dl class="tx">
				<div><dt class="caps-sm">Effect</dt><dd>FAC 101 wave</dd></div>
				<div><dt class="caps-sm">Angle</dt><dd class="num">35°</dd></div>
				<div><dt class="caps-sm">Cycle</dt><dd class="num">14 s</dd></div>
				<div><dt class="caps-sm">Band</dt><dd class="num">26 keys</dd></div>
				<div><dt class="caps-sm">LEDs</dt><dd class="num">{totalLeds} on {devices.length} devices</dd></div>
			</dl>
			<p class="fine plot-note">
				The default effect on the maintainer’s real desk, computed in your browser by the same wave maths uncoild runs.
				Each line is one slice of the desk, back to front; point at it to decode a slice into its live colours.
			</p>
		</div>
	</section>

	<!-- FAC 02 -->
	<section id="does" class="sec" aria-labelledby="does-title">
		<SectionHead id="does-title" fac="FAC 02" title="What it does" />
		<div class="does-grid">
			<ol class="features">
				{
					features.map((f) => (
						<li>
							<span class="caps-sm feat-n">FAC {f.n}</span>
							<div>
								<h3>{f.title}</h3>
								<p>{f.body}</p>
							</div>
						</li>
					))
				}
			</ol>
			<div class="does-figure">
				<DeskMap />
			</div>
		</div>
		<p class="prose-ink also">
			Also: an optional one-shot hand-off of motherboard, GPU and RAM lighting to their own hardware rainbow via OpenRGB,
			so the rest of the case matches without anything else running.
		</p>
	</section>

	<!-- FAC 03 -->
	<section id="app" class="sec" aria-labelledby="app-title">
		<SectionHead id="app-title" fac="FAC 03" title="The app" />
		<div class="app-grid">
			<div class="prose-ink">
				<p>
					A small desktop app sets the effect and shows whether each device is live. You open it, change something, close
					it. The daemon does not need it running, and keeps its own footprint on screen so the claim above stays checkable.
				</p>
				<p>
					Changes land in <code>%APPDATA%\uncoil\config.json</code>, which uncoild hot-reloads. Editing the file by hand
					works just as well.
				</p>
			</div>
			<figure class="shot">
				<Picture
					src={appShot}
					formats={['avif', 'webp']}
					widths={[720, 1100]}
					sizes="(min-width: 1100px) 60vw, 100vw"
					alt="The uncoil desktop app's Lighting screen: a white line plot of the wave with one slice decoded in colour, effect controls, and three Razer devices marked live."
				/>
				<figcaption>
					<span class="caps-sm">The Lighting screen</span>
					<span>
						The desktop app at its default window size, running on its built-in demo data, so the engine figures and
						device rows here are synthetic.
					</span>
				</figcaption>
			</figure>
		</div>
	</section>

	<!-- FAC 04 -->
	<section id="devices" class="sec" aria-labelledby="devices-title">
		<SectionHead id="devices-title" fac="FAC 04" title="Supported devices" />
		<div class="table-wrap">
			<table class="devices">
				<thead>
					<tr>
						<th scope="col" class="caps-sm">Device</th>
						<th scope="col" class="caps-sm">Lighting</th>
						<th scope="col" class="caps-sm">LEDs</th>
						<th scope="col" class="caps-sm">USB</th>
						<th scope="col" class="caps-sm">Data file</th>
					</tr>
				</thead>
				<tbody>
					{
						devices.map((d) => (
							<tr>
								<th scope="row">
									<span class="dev-name">{d.name}</span>
									<span class="caps-sm kind">{d.kind}</span>
								</th>
								<td>{d.lighting}</td>
								<td class="num">{d.leds}</td>
								<td>
									{d.usb.map((u) => (
										<span class="usb">
											<span class="num">{u.pid}</span> <span class="conn">{u.connection}</span>
										</span>
									))}
								</td>
								<td>
									<a href={blob(d.file)}>{d.file.replace('devices/', '')}</a>
								</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
		<p class="prose-ink after-table">
			This table is generated from the same <code>devices/*.toml</code> files the daemon compiles in. Supporting another
			device is mostly a data file: USB endpoints, quirks, the LED matrix and where each LED physically sits.{' '}
			<a href={url('docs/devices/')}>How to add one</a>.
		</p>
	</section>

	<!-- FAC 05 -->
	<section id="built" class="sec" aria-labelledby="built-title">
		<SectionHead id="built-title" fac="FAC 05" title="How it was built" />
		<div class="built-grid">
			<div class="prose-ink">
				<p>
					<strong>Prior art first.</strong> The report format is public thanks to OpenRazer and OpenRGB; uncoil
					re-implements it from those facts.
				</p>
				<p>
					<strong>Then Razer’s own logs.</strong> Synapse 4 logs every command it sends, with a readable name and the raw
					bytes. Mining 130 MB of those logs produced a catalog of 30 commands and 116 distinct input events, with no USB
					sniffer involved.
				</p>
				<p>
					<strong>Then the hardware.</strong> Small Python probes against the real devices, reading back status codes and
					asking a human what the LEDs actually did. The expensive lessons: Synapse leaves devices in driver mode, the
					BlackWidow freezes if the custom-frame command is sent twice, and it silently stops applying frames unless every
					reply is read.
				</p>
				<p class="links">
					<a class="caps caps-link" href={url('docs/protocol/')}>Read the protocol write-up</a>
					<a class="caps caps-link" href={blob('docs/PROTOCOL.md')}>PROTOCOL.md on GitHub</a>
				</p>
			</div>
			<div class="built-figure">
				<ReportStrip />
				<div class="fnp">
					<p class="caps-sm">FAC 503 · Fn+P, written to the keyboard</p>
					<pre><code>02/0D  [1, 26, 1, 2, 2, 0, 0x46]
       profile 1 · key P · Fn layer · key code · Print Screen</code></pre>
					<p class="fine">
						One report into the keyboard’s onboard key map, verified on hardware. Fn+P is now handled by the firmware: no
						driver mode, no daemon, works on any PC.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- FAC 06 -->
	<section id="install" class="sec" aria-labelledby="install-title">
		<SectionHead id="install-title" fac="FAC 06" title="Install" />
		<ol class="steps">
			<li>
				<span class="caps-sm step-n">FAC 601</span>
				<div>
					<h3>Download</h3>
					<p class="prose-ink">
						Get <code>uncoild.exe</code> and <code>install-task.ps1</code> from <a href={RELEASES}>GitHub Releases</a>.
						There is no installer yet; there is not much to install.
					</p>
				</div>
			</li>
			<li>
				<span class="caps-sm step-n">FAC 602</span>
				<div>
					<h3>Retire Synapse</h3>
					<p class="prose-ink">
						Quit Synapse from its tray icon, then uninstall it from Windows Settings. If the keyboard dial scrolls instead of
						changing volume afterwards, the device was left in driver mode: uncoil resets it on connect, and an unplug and
						replug fixes it either way.
					</p>
				</div>
			</li>
			<li>
				<span class="caps-sm step-n">FAC 603</span>
				<div>
					<h3>Run it at logon</h3>
					<pre><code>powershell -ExecutionPolicy Bypass -File install-task.ps1 -Exe .\uncoild.exe</code></pre>
					<p class="prose-ink">
						Copies the executable to <code>%LOCALAPPDATA%\uncoil\bin</code>, registers a scheduled task named{' '}
						<code>uncoil</code> that starts at logon, and starts it now. The lighting should change within a second.
					</p>
				</div>
			</li>
		</ol>
		<p class="prose-ink after-table">
			Building from source instead: <code>cargo build --release -p uncoild</code>. Removing it again, changing settings and
			everything else: <a href={url('docs/getting-started/')}>getting started</a>.
		</p>
	</section>

	<!-- FAC 07 -->
	<section id="faq" class="sec" aria-labelledby="faq-title">
		<SectionHead id="faq-title" fac="FAC 07" title="Questions" />
		<div class="faq">
			{
				faq.map((f, i) => (
					<details>
						<summary>
							<span class="caps-sm faq-n">FAC {701 + i}</span>
							<span class="q">{f.q}</span>
							<span class="tick" aria-hidden="true" />
						</summary>
						<p class="prose-ink" set:html={f.a} />
					</details>
				))
			}
		</div>
	</section>
</Base>

<script>
	// Section rail: box the section in view, red number (the app's active catalog item).
	const links = new Map<string, HTMLAnchorElement>();
	document.querySelectorAll<HTMLAnchorElement>('[data-rail]').forEach((a) => links.set(a.dataset.rail!, a));
	const io = new IntersectionObserver(
		(entries) => {
			for (const e of entries) {
				if (!e.isIntersecting) continue;
				links.forEach((a, id) => a.toggleAttribute('aria-current', id === e.target.id));
			}
		},
		{ rootMargin: '-45% 0px -50% 0px' },
	);
	links.forEach((_, id) => {
		const el = document.getElementById(id);
		if (el) io.observe(el);
	});
</script>

<style>
	/* ── Rail ─────────────────────────────────────────────────────────────── */
	.rail {
		display: none;
	}
	@media (min-width: 1100px) {
		.rail {
			display: block;
			position: fixed;
			top: 0;
			left: 0;
			bottom: 0;
			width: var(--rail);
			border-right: var(--hair);
			background: var(--color-ground);
			z-index: 25;
		}
		.rail ol {
			list-style: none;
			margin: 0;
			padding: calc(var(--header) + 40px) 0 0;
			display: grid;
			gap: 10px;
			justify-items: center;
		}
		.rail a {
			position: relative;
			display: grid;
			place-items: center;
			width: 44px;
			height: 40px;
			text-decoration: none;
			color: var(--color-ink-2);
			border: 1px solid transparent;
			font-size: 13px;
			font-stretch: 115%;
			letter-spacing: 0.16em;
			transition: color var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease);
		}
		.rail a:hover {
			color: var(--color-ink);
			border-color: var(--color-seam-2);
		}
		.rail a[aria-current] {
			color: var(--color-fac-red);
			border-color: var(--color-fac-red);
		}
		.rail-label {
			position: absolute;
			left: calc(100% + 12px);
			white-space: nowrap;
			font-size: 10px;
			font-weight: 500;
			letter-spacing: 0.2em;
			text-transform: uppercase;
			color: var(--color-ink);
			background: var(--color-ground);
			border: var(--hair-strong);
			padding: 4px 8px;
			opacity: 0;
			pointer-events: none;
			transition: opacity var(--t-fast) var(--ease);
		}
		.rail a:hover .rail-label,
		.rail a:focus-visible .rail-label {
			opacity: 1;
		}
		.rail .rail-label {
			clip-path: none;
		}
	}
	@media (max-width: 1099px) {
		.rail-label {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
		}
	}

	/* ── Hero ─────────────────────────────────────────────────────────────── */
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 40px;
		padding: 40px var(--gutter) 56px;
		border-bottom: var(--hair);
	}
	h1 {
		font-size: clamp(2.1rem, 1.1rem + 2.9vw, 3.4rem);
		font-weight: 380;
		font-stretch: 118%;
		letter-spacing: -0.025em;
		line-height: 1.03;
		max-width: 15ch;
		text-wrap: balance;
	}
	.hl {
		font-stretch: 125%;
		white-space: nowrap;
	}
	.lede {
		margin-top: 22px;
		font-size: clamp(1.05rem, 0.98rem + 0.25vw, 1.2rem);
		line-height: 1.5;
		color: var(--color-ink);
		max-width: 44ch;
	}
	.sublede {
		margin-top: 10px;
		color: var(--color-ink-2);
		max-width: 62ch;
	}
	.ledger {
		margin-top: 28px;
		width: 100%;
		max-width: 40rem;
		border-collapse: collapse;
	}
	.ledger thead th {
		text-align: left;
		color: var(--color-ink-3);
		padding: 0 12px 10px 0;
		border-bottom: var(--hair-strong);
		font-weight: 500;
	}
	.ledger tbody th {
		text-align: left;
		font-weight: 400;
		color: var(--color-ink-2);
		font-size: 14px;
		padding: 9px 12px 9px 0;
		vertical-align: baseline;
		width: 30%;
	}
	.ledger td {
		padding: 9px 12px 9px 0;
		border-bottom: var(--hair);
		vertical-align: baseline;
	}
	.ledger tbody th {
		border-bottom: var(--hair);
	}
	.syn {
		color: var(--color-ink-3);
		font-size: 14px;
		width: 38%;
	}
	.unc {
		white-space: nowrap;
	}
	.val {
		font-size: 23px;
		line-height: 1;
		color: var(--color-ink);
	}
	.unit {
		margin-left: 6px;
		font-size: 13px;
		color: var(--color-ink-2);
		white-space: normal;
	}
	.fine {
		margin-top: 12px;
		font-size: 13px;
		line-height: 1.5;
		color: var(--color-ink-3);
		max-width: 60ch;
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	.ctas {
		margin-top: 28px;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 20px 32px;
	}
	.btn-primary {
		display: inline-flex;
		align-items: stretch;
		min-height: 52px;
		border: 1px solid var(--color-ink);
		text-decoration: none;
		color: var(--color-ink);
		transition: background-color var(--t-fast) var(--ease), color var(--t-fast) var(--ease);
	}
	.btn-primary .caps {
		display: flex;
		align-items: center;
		padding: 0 28px;
	}
	.btn-primary .block {
		width: 44px;
		background: var(--color-fac-red);
	}
	.btn-primary:hover {
		background: var(--color-ink);
		color: var(--color-ground);
	}

	.hero-plot {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}
	.plot-frame {
		height: clamp(300px, 70vw, 460px);
	}
	.tx {
		margin: 18px 0 0;
