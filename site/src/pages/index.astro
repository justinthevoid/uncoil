---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import DeskHero from '../components/DeskHero.astro';
import FnKeys from '../components/FnKeys.astro';
import ReportStrip from '../components/ReportStrip.astro';
import SectionHead from '../components/SectionHead.astro';
import shotLight from '../assets/app-lighting-light.png';
import shotDark from '../assets/app-lighting-dark.png';
import { devices } from '../lib/devices';
import { url, REPO, RELEASES, blob } from '../lib/url';

// Measured on the maintainer's PC (README.md, PRODUCT.md). The only numbers on this site.
const ledger = [
	{ k: 'Processes', uncoil: '1', unit: '', synapse: '17' },
	{ k: 'Memory', uncoil: '~3', unit: 'MB', synapse: '~1.4 GB at start, leaking' },
	{ k: 'CPU while animating', uncoil: '<1%', unit: 'of one core', synapse: '~7% of one core' },
	{ k: 'Install size', uncoil: '1.2', unit: 'MB', synapse: '~500 MB' },
];

const features = [
	{
		title: 'One effect across the whole desk',
		body: 'Every LED has a physical position in key units (1u = 19.05 mm), so an angled rainbow wave runs from the keyboard and its underglow onto the mouse and the mat as one continuous field, not three effects that happen to be in sync.',
	},
	{
		title: 'The keyboard keeps its own brain',
		body: 'Devices stay in firmware (normal) mode, so Fn keys, media keys and the dial keep working when uncoil is not running. Key remaps can be written into the keyboard’s own memory: on the BlackWidow, Fn+P becomes a native Print Screen that works with nothing installed at all.',
	},
	{
		title: 'Follows the display',
		body: 'Lighting fades out when Windows turns the display off, dims when Windows dims it, and comes back on wake. Devices that were unplugged are picked up again within seconds.',
	},
	{
		title: 'Even colour',
		body: 'Uses FastLED’s rainbow hue map, tuned for LEDs, so no band of the wave looks wider or brighter than the rest.',
	},
	{
		title: 'Written down',
		body: 'The protocol, the quirks and every device are documented in the repository. A new device is a data file, not a fork.',
	},
];

const faq = [
	{
		q: 'Is uncoil made by Razer?',
		a: `No. It is an independent open-source project, not affiliated with or endorsed by Razer Inc. It speaks the same USB HID reports Razer's software uses, which <a href="https://github.com/openrazer/openrazer">OpenRazer</a> and <a href="https://gitlab.com/CalcProgrammer1/OpenRGB">OpenRGB</a> documented long before uncoil existed.`,
	},
	{
		q: 'What does it cost, and what is the licence?',
		a: `Nothing. uncoil is <a href="${REPO}/blob/main/LICENSE">GPL-3.0-or-later</a>. Protocol facts and some device data derive from OpenRazer and OpenRGB (both GPL-2.0-or-later).`,
	},
	{
		q: 'What still needs Synapse?',
		a: 'Anything uncoil does not do yet: macros, what each command-dial mode does, custom images on the BlackWidow’s dial screen, switching onboard profiles, firmware updates, and devices that are not on the list. Key and button remapping works from the app and the command line, though only one remap (Fn+P to Print Screen) has been checked on a real keyboard so far. DPI, polling rate and the sleep timer are there too, but not yet confirmed on real hardware, so uncoil reads each value before it changes anything. Settings already stored in a device’s own memory stay there after Synapse is gone.',
	},
	{
		q: 'Can Synapse stay installed?',
		a: `Not running at the same time: both would write to the same LEDs. Quit Synapse completely, or uninstall it; the <a href="${url('docs/getting-started/')}">getting started guide</a> covers doing that without leaving the keyboard stuck in driver mode.`,
	},
	{
		q: 'Does it work alongside OpenRGB, SignalRGB or iCUE?',
		a: `Leave the Razer devices to uncoil; any other app driving them will fight it for the LEDs. For the rest of the PC, uncoil can run OpenRGB once at start (on by default, if OpenRGB is installed) to put the motherboard, GPU and RAM on their own hardware rainbow, and skips the RAM while iCUE is running because they share the SMBus. Which devices it targets is fixed in the code today; see <a href="${url('docs/configuration/#openrgb_hardware_rainbow')}">configuration</a>.`,
	},
	{
		q: 'Why does the logon task run elevated?',
		a: 'Only so the optional OpenRGB hand-off can reach RAM over SMBus. The daemon itself talks to Razer devices as plain user-mode HID. There is no service and no kernel driver.',
	},
	{
		q: 'Does it phone home?',
		a: 'No. There is no account, no telemetry and no updater. uncoild reads one config file, writes a status file, a small log and a record of writes to device memory, all under your user profile, and answers the app and the command line over a local pipe only your account can open.',
	},
	{
		q: 'Mac or Linux?',
		a: 'Windows 10 and 11 only. On Linux, <a href="https://openrazer.github.io/">OpenRazer</a> already does this job well.',
	},
];

const sentence = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const shotAlt =
	'The uncoil desktop app’s Lighting screen: the desk drawn to scale and lit with the wave, cards for every effect from Wave to Off plus Studio, and the wave’s direction, speed, band width, reverse, brightness and saturation controls.';
---

<Base
	title="uncoil: a 1.2 MB replacement for Razer Synapse"
	description="uncoil runs the lighting on Razer keyboards, mice and mats from one small background process on Windows. Open source, GPL-3.0. Measured on one PC: ~3 MB RAM, under 1% of one core."
>
	<section id="top" class="hero wrap" aria-labelledby="hero-title">
		<div class="hero-top">
			<h1 id="hero-title">A 1.2&nbsp;MB replacement for Razer Synapse.</h1>
			<div class="hero-side">
				<p class="lede">
					uncoil runs the lighting on your Razer keyboard, mouse and mat from one small background process on Windows.
					Uninstall Synapse; keep the desk.
				</p>
				<p class="sublede">Open source. No services, no account, no telemetry, no kernel drivers.</p>
				<p class="sublede">Pre-release: nothing has been released yet, so for now you build it from source.</p>
				<div class="ctas">
					<a class="btn" href={url('docs/getting-started/')}>Read the setup guide</a>
					<a class="btn-quiet" href={REPO}>Source on GitHub</a>
				</div>
			</div>
		</div>

		<DeskHero />
		<p class="fine hero-note">
			The default effect on the maintainer’s desk, computed in your browser by the same wave maths uncoild runs. Every
			key, underglow LED, mouse LED and the mat’s edge sits at its measured position.
		</p>
	</section>

	<section id="measured" class="sec" aria-labelledby="measured-title">
		<div class="wrap">
			<SectionHead
				id="measured-title"
				title="Measured on one PC"
				lede="uncoild against Razer Synapse 4, on the maintainer’s desktop."
			/>
			<dl class="stats">
				{
					ledger.map((r) => (
						<div class="stat card">
							<dt class="label">{r.k}</dt>
							<dd class="now">
								<span class="val num">{r.uncoil}</span>
								{r.unit && <span class="unit">{r.unit}</span>}
							</dd>
							<dd class="was">
								<span class="sr-only">Synapse 4: </span>
								<span aria-hidden="true">Synapse 4 · </span>
								{r.synapse}
							</dd>
						</div>
					))
				}
			</dl>
			<p class="fine">
				A Ryzen desktop with a BlackWidow V4 Pro 75%, Basilisk V3 Pro and Goliathus Chroma Extended, where Synapse’s
				memory grew to several GB over a few days. Memory and CPU were measured on an earlier build. One machine; yours will differ.
			</p>
		</div>
	</section>

	<section id="does" class="sec" aria-labelledby="does-title">
		<div class="wrap">
			<SectionHead id="does-title" title="What it does" />
			<div class="does-grid">
				<ul class="features">
					{
						features.map((f) => (
							<li>
								<h3>{f.title}</h3>
								<p>{f.body}</p>
							</li>
						))
					}
				</ul>
				<div class="does-figure">
					<h3>What the colours on keys mean</h3>
					<p class="prose-ink">
						When a key does something different, the app gives it a coloured tab: a gel that names the kind of change.
						There are four, each with one job, and each always appears with its name.
					</p>
					<ul class="gels" aria-label="The four gels">
						<li><span class="gel gel-yours" aria-hidden="true"></span><span><b>Your change</b> keys and buttons you remapped</span></li>
						<li><span class="gel gel-media" aria-hidden="true"></span><span><b>Media &amp; macros</b> media keys, macro record, game mode</span></li>
						<li><span class="gel gel-light" aria-hidden="true"></span><span><b>Lighting</b> backlight brighter and dimmer</span></li>
						<li><span class="gel gel-system" aria-hidden="true"></span><span><b>System</b> sleep, low power, profiles and DPI</span></li>
					</ul>
					<FnKeys />
					<p class="fine">
						The BlackWidow V4 Pro 75% with Fn held, drawn from its real layout. The actions are the keyboard’s own
						onboard Fn map; Fn+P is the one uncoil wrote. Any other colour on this site is a device’s real LED colour.
					</p>
				</div>
			</div>
			<p class="prose-ink also">
				Also: a command line, <code>uncoil</code>, for everything the app does with devices; and an optional one-shot
				hand-off (on by default) of motherboard, GPU and RAM lighting to their own hardware rainbow via OpenRGB, so the
				rest of the case matches without anything else running.
			</p>
		</div>
	</section>

	<section id="app" class="sec" aria-labelledby="app-title">
		<div class="wrap app-grid">
			<div>
				<SectionHead id="app-title" title="The app" />
				<div class="prose-ink">
					<p>
						A small desktop app sets the effect, layers effects and painted keys in Studio, remaps keys and buttons, sets the dial, the screen, DPI, polling rate and sleep timer, and shows whether each device is live. You open it, change something,
						close it. The daemon does not need it running. The app shows the daemon’s own memory and CPU in its top bar,
						so the numbers above stay checkable.
					</p>
					<p>
						Changes land in <code>%APPDATA%\uncoil\config.json</code>, which uncoild hot-reloads. Editing the file by
						hand works just as well.
					</p>
					<p>It follows Windows for light and dark, like this page.</p>
				</div>
			</div>
			<figure class="shot">
				<div class="shot-frame">
					<Picture
						class="shot-light"
						src={shotLight}
						formats={["avif"]}
						fallbackFormat="webp"
						widths={[720, 1100, 1440]}
						sizes="(min-width: 1100px) 760px, 100vw"
						alt={shotAlt}
					/>
					<Picture
						class="shot-dark"
						src={shotDark}
						formats={["avif"]}
						fallbackFormat="webp"
						widths={[720, 1100, 1440]}
						sizes="(min-width: 1100px) 760px, 100vw"
						alt={shotAlt}
					/>
				</div>
				<figcaption>
					<span class="cap-title">The Lighting screen</span>
					<span>
						The desktop app at its default window size, running on its built-in demo data, so the device rows and engine
						figures shown are synthetic.
					</span>
				</figcaption>
			</figure>
		</div>
	</section>

	<section id="devices" class="sec" aria-labelledby="devices-title">
		<div class="wrap">
			<SectionHead id="devices-title" title="Supported devices" />
			<div class="table-wrap card">
				<table class="devices">
					<thead>
						<tr>
							<th scope="col">Device</th>
							<th scope="col">Lighting</th>
							<th scope="col">LEDs</th>
							<th scope="col">USB</th>
							<th scope="col">Data file</th>
						</tr>
					</thead>
					<tbody>
						{
							devices.map((d) => (
								<tr>
									<th scope="row">
										<span class="dev-name">{d.name}</span>
										<span class="kind">{sentence(d.kind)}</span>
									</th>
									<td>{d.lighting}</td>
									<td class="num">{d.leds}</td>
									<td>
										{d.usb.map((u) => (
											<span class="usb">
												<span class="num">{u.pid}</span> <span class="conn">{u.connection}</span>
											</span>
										))}
									</td>
									<td>
										<a href={blob(d.file)}>{d.file.replace('devices/', '')}</a>
									</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
			<p class="prose-ink after-table">
				Generated from the same <code>devices/*.toml</code> files the daemon compiles in. Supporting another device is
				mostly a data file: USB endpoints, quirks, the LED matrix and where each LED physically sits.{' '}
				<a href={url('docs/devices/')}>How to add one</a>.
			</p>
		</div>
	</section>

	<section id="built" class="sec" aria-labelledby="built-title">
		<div class="wrap built-grid">
			<div>
				<SectionHead id="built-title" title="How it was built" />
				<div class="prose-ink">
					<p>
						<strong>Prior art first.</strong> The report format is public thanks to OpenRazer and OpenRGB; uncoil
						re-implements it from those facts.
					</p>
					<p>
						<strong>Then Razer’s own logs.</strong> Synapse 4 logs every command it sends, with a readable name and the
						raw bytes. Mining 130 MB of those logs produced a catalogue of 30 commands and 116 distinct input events, with
						no USB sniffer involved.
					</p>
					<p>
						<strong>Then the hardware.</strong> Small Python probes against the real devices, reading back status codes
						and asking a human what the LEDs actually did. The expensive lessons: Synapse leaves devices in driver mode,
						the BlackWidow freezes if the custom-frame command is sent twice, and it silently stops applying frames
						unless every reply is read.
					</p>
				</div>
				<p class="links">
					<a class="btn-quiet" href={url('docs/protocol/')}>Read the protocol write-up</a>
					<a class="more" href={blob('docs/PROTOCOL.md')}>PROTOCOL.md on GitHub</a>
				</p>
			</div>
			<div class="built-figure">
				<p class="fig-title">One feature report, all 90 bytes</p>
				<ReportStrip />
				<div class="fnp">
					<p class="fig-title">Fn+P, written to the keyboard</p>
					<pre><code>02/0D  [1, 26, 1, 2, 2, 0, 0x46]
       profile 1 · key P · Fn layer · key code · Print Screen</code></pre>
					<p class="fine">
						One report into the keyboard’s onboard key map, verified on hardware. Fn+P is now handled by the firmware:
						no driver mode, no daemon, works on any PC.
					</p>
				</div>
			</div>
		</div>
	</section>

	<section id="install" class="sec" aria-labelledby="install-title">
		<div class="wrap">
			<SectionHead id="install-title" title="Install" lede="Three steps. There is no installer yet; there is not much to install." />
			<ol class="steps">
				<li>
					<h3>Build</h3>
					<p class="prose-ink">
						Nothing has been released yet, so build it: <code>cargo build --release -p uncoild</code> in a clone of the
						<a href={REPO}>repository</a>. Once there is a release, <code>uncoild.exe</code> and <code>install-task.ps1</code> will be
						on <a href={RELEASES}>GitHub Releases</a>.
					</p>
				</li>
				<li>
					<h3>Retire Synapse</h3>
					<p class="prose-ink">
						Quit Synapse from its tray icon, then uninstall it from Windows Settings. If the keyboard dial scrolls
						instead of changing volume afterwards, the device was left in driver mode: uncoil resets it on connect, and
						an unplug and replug fixes it either way.
					</p>
				</li>
				<li>
					<h3>Run it at logon</h3>
					<pre><code>powershell -ExecutionPolicy Bypass -File scripts\install-task.ps1</code></pre>
					<p class="prose-ink">
						Copies the executable to <code>%ProgramFiles%\uncoil</code>, registers a scheduled task named{' '}
						<code>uncoil</code> that starts at logon, and starts it now. The lighting should change within a second.
					</p>
				</li>
			</ol>
			<p class="prose-ink after-table">
				The optional command line builds the same way (<code>-p uncoil-cli</code>). Removing it again, changing
				settings and everything else: <a href={url('docs/getting-started/')}>getting started</a>.
			</p>
		</div>
	</section>

	<section id="faq" class="sec" aria-labelledby="faq-title">
		<div class="wrap">
			<SectionHead id="faq-title" title="Questions" />
			<div class="faq card">
				{
					faq.map((f) => (
						<details>
							<summary>
								<span class="q">{f.q}</span>
								<svg class="chev" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
									<path d="M4 6l4 4 4-4" />
								</svg>
							</summary>
							<p class="prose-ink" set:html={f.a} />
						</details>
					))
				}
			</div>
		</div>
	</section>
</Base>

<style>
	/* ── Hero ─────────────────────────────────────────────────────────────── */
	.hero {
		padding-top: clamp(28px, 4vw, 52px);
		padding-bottom: clamp(40px, 6vw, 72px);
	}
	.hero-top {
		display: grid;
		gap: 20px;
		margin-bottom: clamp(24px, 3vw, 36px);
	}
	h1 {
		font-size: clamp(2.1rem, 1.3rem + 2.6vw, 3.3rem);
		letter-spacing: -0.025em;
		line-height: 1.05;
		max-width: 18ch;
	}
	.lede {
		font-size: clamp(1.05rem, 1rem + 0.25vw, 1.2rem);
		line-height: 1.5;
		color: var(--color-ink);
		max-width: 46ch;
	}
	.sublede {
		margin-top: 8px;
		color: var(--color-ink-2);
	}
	.ctas {
		margin-top: 22px;
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}
	.ctas svg {
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.fine {
		margin-top: 12px;
		font-size: 14px;
		line-height: 1.5;
		color: var(--color-ink-3);
		max-width: 72ch;
	}
	@media (min-width: 900px) {
		.hero-top {
			grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
			align-items: end;
			gap: 48px;
		}
	}

	/* ── Sections ─────────────────────────────────────────────────────────── */
	.sec {
		padding: 64px 0 72px;
		border-top: var(--hair);
	}
	@media (min-width: 900px) {
		.sec {
			padding: 88px 0 96px;
		}
	}
	h3 {
		font-size: 1.125rem;
		line-height: 1.3;
	}

	/* Measured */
	.stats {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 10px;
		margin: 0;
	}
	.stat {
		display: grid;
		align-content: start;
		gap: 6px;
		padding: 18px;
	}
	.stat dd {
		margin: 0;
	}
	.now {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 2px 8px;
	}
	.val {
		font-family: var(--font-display);
		font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.5rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.05;
		color: var(--color-ink);
	}
	.unit {
		font-size: 15px;
		font-weight: 500;
		color: var(--color-ink-2);
	}
	.was {
		margin-top: 6px;
		padding-top: 10px;
		border-top: var(--hair);
		font-size: 14px;
		color: var(--color-ink-3);
	}
	@media (min-width: 900px) {
		.stats {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
	@media (max-width: 380px) {
		.stat {
			padding: 14px;
		}
	}

	/* What it does */
	.does-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 48px;
	}
	.features {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.features li {
		padding: 20px 0;
		border-top: var(--hair);
	}
	.features li:last-child {
		border-bottom: var(--hair);
	}
	.features p {
		margin-top: 6px;
		color: var(--color-ink-2);
		max-width: 60ch;
	}
	.does-figure > .prose-ink {
		margin-top: 8px;
	}
	.gels {
		list-style: none;
		margin: 16px 0 20px;
		padding: 0;
		display: grid;
		gap: 8px;
		font-size: 15px;
		color: var(--color-ink-2);
	}
	.gels li {
		display: grid;
		grid-template-columns: 10px minmax(0, 1fr);
		column-gap: 10px;
		align-items: baseline;
	}
	.gels .gel {
		align-self: center;
	}
	.gels b {
		font-weight: 600;
		color: var(--color-ink);
		margin-right: 6px;
	}
	.also {
		margin-top: 40px;
	}
	@media (min-width: 1000px) {
		.does-grid {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
			align-items: start;
			gap: 56px;
		}
	}

	/* The app */
	.app-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 36px;
	}
	.app-grid .prose-ink p + p {
		margin-top: 14px;
	}
	.shot {
		margin: 0;
	}
	.shot-frame {
		border: var(--hair-strong);
		border-radius: var(--radius-lg);
		overflow: hidden;
		background: var(--color-raised);
	}
	.shot :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}
	.shot :global(.shot-dark) {
		display: none;
	}
	@media (prefers-color-scheme: dark) {
		.shot :global(.shot-dark) {
			display: block;
		}
		.shot :global(.shot-light) {
			display: none;
		}
	}
	.shot figcaption {
		display: grid;
		gap: 2px;
		margin-top: 12px;
		font-size: 14px;
		color: var(--color-ink-3);
	}
	.cap-title {
		font-weight: 600;
		color: var(--color-ink);
	}
	@media (min-width: 1100px) {
		.app-grid {
			grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
			gap: 56px;
			align-items: start;
		}
	}

	/* Devices */
	.table-wrap {
		overflow-x: auto;
	}
	.devices {
		width: 100%;
		min-width: 640px;
		border-collapse: collapse;
		font-size: 15px;
