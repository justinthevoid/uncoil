	/* the one brass lamp: placed by the film, composited, never repainted */
	.lamp {
		position: fixed;
		left: 0;
		top: 0;
		width: 1000px;
		height: 1000px;
		z-index: 0;
		pointer-events: none;
		border-radius: 50%;
		background: radial-gradient(closest-side, rgb(201 164 106 / 0.075), rgb(201 164 106 / 0.025) 45%, rgb(201 164 106 / 0));
		transform: scale(0);
