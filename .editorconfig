root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4
max_line_length = 120

[*.{py,toml}]
indent_size = 4

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false
max_line_length = 120

[*.{ps1,psm1,psd1,cmd,bat}]
end_of_line = crlf
indent_size = 4

[{Cargo.lock,pnpm-lock.yaml}]
# Generated; leave formatting to the tools.
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset

[LICENSE]
indent_style = unset
indent_size = unset
